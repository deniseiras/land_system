        if (NANDAT > 20110817 and NANDAT < 20110823) then fail(EXPERIMENTAL); endif;
 # passive monitoring MTSAT-2 back in service
        if (NANDAT > 20130114 and NANDAT < 20130205) then fail(EXPERIMENTAL); endif;
 # MTSAT-2 manoeuvre
        if (NANDAT >= 20130624 and NANDAT < 20130731) then fail(EXPERIMENTAL); endif;
 # passive monitoring MTSAT-2 back in service
        if (NANDAT > 20140113 and NANDAT < 20140128) then fail(EXPERIMENTAL); endif;
 # passive monitoring MTSAT-2 back in service
        if (NANDAT >= 20141216 and NANDAT < 20150108) then fail(EXPERIMENTAL); endif;
      elif SATELLITE_IDENTIFIER in (173) then
        # Blacklist HIMAWARI-8 data
        if (NANDAT <= 20151125) then fail(CONSTANT); endif;
        if (VERT_CO = TOVS_CHA and PRESS notin (2, 3, 4, 7)) then fail(CONSTANT); endif;
        if ( SATZA > 74 ) then fail(CONSTANT); endif;
        if (MODORO > 1500 ) then fail(CONSTANT); endif;
        # water vapour channel
        if ( PRESS in (2, 3, 4) ) then
          if ( (LSMASK = sea) and ((WINCHAN_DEP < -3.) or (WINCHAN_DEP > 3.)) ) then
          fail(CONSTANT); endif;
          # Exclude data with smaller amount of clear pixels in CSR mean
          if ( (LSMASK = land) and ( CSR_PCLEAR < 50 ) ) then fail(CONSTANT); endif;
        endif;
        # window channel
        if ( PRESS in (7) ) then
          if ( LSMASK = land ) then fail(CONSTANT); endif;
          if ( CSR_PCLEAR < 70 ) then fail(CONSTANT); endif;
        endif;
        if ( PRESS in (7) ) then fail(EXPERIMENTAL); endif;
 # passive monitoring for integration
        if (NANDAT > 20151125 and NANDAT < 20160112) then fail(EXPERIMENTAL); endif;
      elif SATELLITE_IDENTIFIER in (270,271) then
        # Blacklist GOES-16 data
        if (( SATELLITE_IDENTIFIER in (270)) and (NANDAT < 20180522)) then
          fail(CONSTANT);
        endif;
        # Blacklist GOES-17 data
        if (( SATELLITE_IDENTIFIER in (271)) and (NANDAT < 20210413)) then
          fail(CONSTANT);
        endif;
        if (VERT_CO = TOVS_CHA and PRESS notin (2, 3, 4, 7)) then fail(CONSTANT); endif;
        if ( SATZA > 60 ) then fail(CONSTANT); endif;
        if (MODORO > 1500 ) then fail(CONSTANT); endif;
        # water vapour channel
        if ( PRESS in (2, 3, 4) ) then
          if ( (LSMASK = sea) and ((WINCHAN_DEP < -3.) or (WINCHAN_DEP > 3.)) ) then
          fail(CONSTANT); endif;
          # Exclude data with smaller amount of clear pixels in CSR mean
          if ( (LSMASK = land) and ( CSR_PCLEAR < 50 ) ) then fail(CONSTANT); endif;
          if ( REPRES_ERROR > 4 ) then fail(CONSTANT); endif;
        endif;
        # window channel
        if ( PRESS in (7) ) then
          if ( LSMASK = land ) then fail(CONSTANT); endif;
          if ( CSR_PCLEAR < 70 ) then fail(CONSTANT); endif;
        endif;
        if ( PRESS in (7) ) then fail(EXPERIMENTAL); endif;
        # Passively monitor GOES-16 initially
        if (( SATELLITE_IDENTIFIER in (270)) and (NANDAT >= 20180522) and (NANDAT < 20180726)) then
          fail(EXPERIMENTAL);
        endif;
        # Passively monitor GOES-17 initially
        if (( SATELLITE_IDENTIFIER in (271)) and (NANDAT >= 20210413) and (NANDAT < 20210518)) then
          fail(EXPERIMENTAL);
        endif;
        # Passively monitor GOES-16 change V1 to V2 BUFR processing
        if (( SATELLITE_IDENTIFIER in (270)) and (NANDAT >= 20210413) and (NANDAT < 20210427)) then
          fail(EXPERIMENTAL);
        endif;
      else
        fail(CONSTANT); # Unknown geo satellite
      endif;
    else
      fail(CONSTANT); # Unknown rad1c sensor
    endif;
  else
    fail(CONSTANT); # Unknown / unwanted codetype or variable
  endif;
#-------------------- SATOB CONSTANT DATA SELECTION ------------------------
elif (OBSTYP = satob) then
  # Use only wind observations
  if VARIAB notin (u, v) then fail(CONSTANT); endif;
  # Blacklist old-style SATOB-coded winds
  if ( CODTYP in (88) )
    then fail(CONSTANT); endif;
  # 52 - MET-5, 54 - MET-7, 55 - MET-8,
  # 56 - MET-9, 57 - MET-10, 70 - MET-11
  # 171 - MTSAT-1R, 172 - MTSAT-2, 173 - Himawari-8
  # 253 - GOES-9, 254 - GOES-10, 255 - GOES-11,
  # 256 - GOES-12, 257 - GOES-13, 259 - GOES-15, 270 - GOES-16
  # 271 - GOES-17
  # 783 - MODIS (TERRA, NOAA/NESDIS), 784 - MODIS (AQUA, NOAA/NESDIS),
  # 773 - MODIS (TERRA, CIMSS), 774 - MODIS (AQUA, CIMSS)
  # 206 - NOAA-15, 207 - NOAA-16, 209 - NOAA-18, 223 - NOAA-19
  # 3 - METOP-B, 4 - METOP-A, 852 - dual METOP, 224 - SNPP
  # 5 - METOP-C, 225 - NOAA-20
  # General conditions for all satellites:
  #=======================================
  # Check for sensible pressure
  if ( PRESS > 1000 or PRESS < 100 )
    then fail(CONSTANT); endif;
  # Check for sensible geographical coverage
  if SATELLITE_IDENTIFIER in (783, 784, 773, 774, 206, 207, 209, 223, 3, 4, 5, 224, 225) then
    # Blacklist polar AMVs outside polar regions
    if ( -60 < LAT < 60 ) then fail(); endif;
  elif SATELLITE_IDENTIFIER in (852) then
    # Blacklist dual Metop-A/B AMVs outside 40-60 N/S regions
    if (abs(LAT) < 40 or abs(LAT) > 60 ) then fail(); endif;
  else
    # Check on satellite zenith angle for geo-winds
    if ( SATZA > 64 or SATZA < 0 ) then fail(CONSTANT); endif;
  endif;
  # Treatment over land for geo winds: Blacklist all data over land for
  # the northern extra-tropics (excluding a region over northern Africa
  # and Asia where winds are allowed). Elsewhere, blacklist data below
  # 500 hPa over land.
  if SATELLITE_IDENTIFIER notin (783, 784, 773, 774, 206, 207, 209, 223, 3, 4, 5, 852, 224, 225) then
    if ( LSMASK = land ) then
      if ( -20 < LON < 30) then # North Africa
        if ( LAT >= 35 ) then
          fail(CONSTANT);
        else
          if (PRESS > 500) then fail(CONSTANT); endif;
        endif;
      else
        if ( 30 <= LON < 100 ) then # Central Asia
          if (PRESS > 500) then fail(CONSTANT); endif;
        else
          if ( LAT >= 20 ) then
            fail(CONSTANT);
          else
            if (PRESS > 500) then fail(CONSTANT); endif;
          endif;
        endif;
      endif;
    endif;
  endif;
  # Blacklist all winds in a box over the Himalayas
  if ( ( LAT < 40 and LAT > 25 ) and ( LON < 105 and LON > 70 ) )
    then fail(); endif;
  # QI or regional blacklisting, satellite-group specific
  # This section also defines the allowable satellites
  #======================================================
  if SATELLITE_IDENTIFIER in (52, 54) then
    # QI-dependent blacklisting for MET-5 and MET-7 winds
    if RETR_TYP in (vis) then
      if (PRESS <= 700)
        then fail(CONSTANT); endif;
      if ( (QI_FC <= 65) or (QI_FC > 100))
        then fail(CONSTANT); endif;
    endif;
    if RETR_TYP in (ir) then
      if ( ( PRESS >= 700 ) and ( QI_FC < 85 ) )
        then fail(CONSTANT); endif;
      if ( ( 700 > PRESS > 400 ) and ( QI_FC < 90 ) )
        then fail(CONSTANT); endif;
      if ( ( 400 >= PRESS ) and ( LAT >= 20 ) and ( QI_FC < 60 ) )
        then fail(CONSTANT); endif;
      if ( ( 400 >= PRESS ) and ( -20 < LAT < 20 ) and ( QI_FC < 85 ) )
        then fail(CONSTANT); endif;
      if ( ( 400 >= PRESS ) and ( LAT <= -20 ) and ( QI_FC < 60 ) )
        then fail(CONSTANT); endif;
    endif;
    if RETR_TYP in (wvcl) then
      if ( PRESS >= 401 )
        then fail(CONSTANT); endif;
      if ( ( LAT >= 20 ) and ( QI_FC < 60 ) )
        then fail(CONSTANT); endif;
      if ( ( -20 < LAT < 20 ) and ( QI_FC < 85 ) )
        then fail(CONSTANT); endif;
      if ( ( LAT <= -20 ) and ( QI_FC < 60 ) )
        then fail(CONSTANT); endif;
    endif;
    if RETR_TYP in (wvmw,wv)
      then fail(CONSTANT); endif;
  elif SATELLITE_IDENTIFIER in (55) then
    # QI-dependent blacklisting for MET-8 winds
    if RETR_TYP notin (vis2, ir3, wvcl1, wvcl2)
      then fail(CONSTANT); endif;
    if ( QI_NOFC > 100 )
      then fail(CONSTANT); endif;
    if (PRESS < 150)
      then fail(CONSTANT); endif;
    if RETR_TYP in (vis2) then
      if (PRESS <= 700)
        then fail(CONSTANT); endif;
      if ( QI_NOFC <= 85 )
        then fail(CONSTANT); endif;
    endif;
    if RETR_TYP in (ir3) then
      if ( ( PRESS >= 700 ) and ( QI_NOFC < 85 ) )
        then fail(CONSTANT); endif;
      if ( ( LAT >= 25 ) or ( LAT <= -25 ) ) then
        if ( QI_NOFC < 85 )
          then fail(CONSTANT); endif;
      endif;
      if ( -25 < LAT < 25 ) then
        if ( PRESS > 250 )
          then fail(CONSTANT); endif;
        if ( QI_NOFC < 85 )
          then fail(CONSTANT); endif;
      endif;
    endif;
    if RETR_TYP in (wvcl1) then
      if ( PRESS > 400 )
        then fail(CONSTANT); endif;
      if ( ( LAT >= 25 ) or ( LAT <= -25 ) ) then
        if ( QI_NOFC < 85 )
          then fail(CONSTANT); endif;
      endif;
      if ( -25 < LAT < 25 ) then
        if ( PRESS > 250 )
          then fail(CONSTANT); endif;
        if ( QI_NOFC < 85 )
          then fail(CONSTANT); endif;
      endif;
    endif;
    if RETR_TYP in (wvcl2) then
      if ( PRESS > 600 )
        then fail(CONSTANT); endif;
      if ( ( LAT >= 25 ) or ( LAT <= -25 ) ) then
        if ( QI_NOFC < 85 )
          then fail(CONSTANT); endif;
      endif;
      if ( -25 < LAT < 25 ) then
        if ( PRESS > 250 )
          then fail(CONSTANT); endif;
        if ( QI_NOFC < 85 )
          then fail(CONSTANT); endif;
      endif;
    endif;
  elif SATELLITE_IDENTIFIER in (56,57,70) then
    # QI-dependent blacklisting for MET-9, MET-10 and MET-11 winds
    if RETR_TYP notin (vis2, ir3, wvcl1, wvcl2)
      then fail(CONSTANT); endif;
    if ( QI_NOFC > 100 )
      then fail(CONSTANT); endif;
    if RETR_TYP in (vis2) then
      if (PRESS <= 700)
        then fail(CONSTANT); endif;
      if ( QI_NOFC <= 85 )
        then fail(CONSTANT); endif;
    endif;
    if RETR_TYP in (ir3) then
      if ( ( PRESS >= 700 ) and ( QI_NOFC < 85 ) )
        then fail(CONSTANT); endif;
      if ( ( LAT >= 25 ) or ( LAT <= -25 ) ) then
        if ( QI_NOFC < 85 )
          then fail(CONSTANT); endif;
      endif;
      if ( -25 < LAT < 25 ) then
        if ( PRESS > 250 )
          then fail(CONSTANT); endif;
        if ( QI_NOFC < 85 )
          then fail(CONSTANT); endif;
      endif;
    endif;
    if RETR_TYP in (wvcl1) then
      if ( PRESS > 400 )
        then fail(CONSTANT); endif;
      if ( ( LAT >= 25 ) or ( LAT <= -25 ) ) then
        if ( QI_NOFC < 85 )
          then fail(CONSTANT); endif;
      endif;
      if ( -25 < LAT < 25 ) then
        if ( PRESS > 250 )
          then fail(CONSTANT); endif;
        if ( QI_NOFC < 85 )
          then fail(CONSTANT); endif;
      endif;
    endif;
    if RETR_TYP in (wvcl2) then
      if ( PRESS > 600 )
        then fail(CONSTANT); endif;
      if ( ( LAT >= 25 ) or ( LAT <= -25 ) ) then
        if ( QI_NOFC < 85 )
          then fail(CONSTANT); endif;
      endif;
      if ( -25 < LAT < 25 ) then
        if ( PRESS > 250 )
          then fail(CONSTANT); endif;
        if ( QI_NOFC < 85 )
          then fail(CONSTANT); endif;
      endif;
    endif;
  elif SATELLITE_IDENTIFIER in (254, 255, 256, 257, 259) then
    # Blacklisting for GOES winds
    if RETR_TYP notin (ir1,wvcl3,vis1)
      then fail(CONSTANT); endif;
    if ( (QI_NOFC < 50) or (QI_NOFC > 100))
      then fail(CONSTANT); endif;
    if RETR_TYP in (wvcl1,wvcl2,wvcl3) then
      if ( PRESS >= 401 )
        then fail(CONSTANT); endif;
    endif;
    if RETR_TYP in (vis1) then
      if (PRESS <= 700)
        then fail(CONSTANT); endif;
    endif;
  elif SATELLITE_IDENTIFIER in (270,271) then
    # Blacklisting for GOES-16,-17 winds
    if RETR_TYP notin (ir1,wvcl3,vis1)
      then fail(CONSTANT); endif;
    if (PRESS < 150)
      then fail(CONSTANT); endif;
    if ( (QI_NOFC <= 90) or (QI_NOFC > 100))
      then fail(CONSTANT); endif;
    if RETR_TYP in (wvcl3) then
      if ( ( LAT >= 25 ) or ( LAT <= -25 ) ) then
        if ( PRESS > 300 )
          then fail(CONSTANT); endif;
      else
        if ( PRESS < 200 )
          then fail(CONSTANT); endif;
      endif;
    endif;
    if RETR_TYP in (ir1) then
      if ( -25 < LAT < 25 ) then
        if ( (PRESS > 300) or (PRESS < 200) )
          then fail(CONSTANT); endif;
      endif;
    endif;
    if RETR_TYP in (vis1) then
      if (PRESS <= 700)
        then fail(CONSTANT); endif;
    endif;
  elif SATELLITE_IDENTIFIER in (171, 172) then
    # QI-dependent blacklisting for MTSAT winds
    if (QI_FC < 85 or QI_FC > 100)
      then fail(CONSTANT); endif;
    if RETR_TYP in (vis) then
      if (PRESS <= 700)
        then fail(CONSTANT); endif;
    endif;
    if RETR_TYP in (wv,wvcl) then
      if ( PRESS >= 401 )
        then fail(CONSTANT); endif;
    endif;
    if RETR_TYP in (wvmw) and (NANDAT > 20050517 )
      then fail(CONSTANT); endif;
  elif SATELLITE_IDENTIFIER in (173) then
    #Data selection for Himawari-8 winds
    if ((QI_NOFC < 70) or (QI_NOFC > 100))
      then fail(CONSTANT); endif;
    if RETR_TYP notin (vis1, ir1, wvcl2)
      then fail(CONSTANT); endif;
    if RETR_TYP in (vis1) then
      if (PRESS <= 700)
        then fail(CONSTANT); endif;
    endif;
    if RETR_TYP in (wvcl2) then
      if (PRESS >= 401)
        then fail(CONSTANT); endif;
    endif;
    if RETR_TYP in (ir1) then
      if ( -25 < LAT < 25 ) then
        if ( PRESS > 300 )
          then fail(CONSTANT); endif;
      endif;
    endif;
    if (PRESS < 150)
      then fail(CONSTANT); endif;
  elif SATELLITE_IDENTIFIER in (783, 784) then
    # Data selection for MODIS winds
    if RETR_TYP in (vis)
      then fail(CONSTANT); endif;
    if RETR_TYP in (ir) then
      if (LSMASK = land and PRESS > 400)
        then fail(CONSTANT); endif;
      if (PRESS > 700)
        then fail(CONSTANT); endif;
    endif;
    if RETR_TYP in (wvcl, wvmw, wv) then
      if (LSMASK = land and PRESS > 400)
        then fail(CONSTANT); endif;
      if ( PRESS >= 550 )
       then fail(CONSTANT); endif;
    endif;
  elif SATELLITE_IDENTIFIER in (206, 207, 209, 223) then
    # Data selection for AVHRR winds
    if RETR_TYP in (ir) then
      if (LSMASK = land and PRESS > 400)
        then fail(CONSTANT); endif;
      if (PRESS > 700)
        then fail(CONSTANT); endif;
    endif;
  elif SATELLITE_IDENTIFIER in (3, 4, 5, 852) then
    # Data selection for Metop-A, Metop-B, Metop-C and dual Metop-AB AVHRR winds
    if ( (QI_NOFC < 60) or (QI_NOFC > 100))
      then fail(CONSTANT); endif;
    if RETR_TYP in (ir) then
      if (LSMASK = land and PRESS > 400)
        then fail(CONSTANT); endif;
      if (PRESS > 700)
        then fail(CONSTANT); endif;
    endif;
  elif SATELLITE_IDENTIFIER in (224,225) then
    # Data selection for VIIRS winds
    if ( (QI_NOFC < 60) or (QI_NOFC > 100))
      then fail(CONSTANT); endif;
    if RETR_TYP in (ir) then
      if (LSMASK = land and PRESS > 400)
        then fail(CONSTANT); endif;
      if (PRESS > 700)
        then fail(CONSTANT); endif;
    endif;
  else
    fail(CONSTANT); # Unknown satellite
  endif;
  # Satellite outages and change-overs
  #===================================
  # MET-5
  if (SATELLITE_IDENTIFIER = 52) then
    # MET-5 supposed to retire (replaced with MET-7), but brought back due
    # to MET-7 problems
    if (NANDAT >= 20070201 and NANDAT < 20070212) then fail(CONSTANT); endif;
    # Termination of MET-5 products
    if (NANDAT >= 20070214) then fail(CONSTANT); endif;
  endif;
  # MET-7
  if (SATELLITE_IDENTIFIER = 54) then
    # Blacklist MET-7 winds before 20060109, when MET-7 winds are brought back
    # briefly to replace MET-8 winds during outage
    if (NANDAT < 20060109) then fail(CONSTANT); endif;
    # Blacklist data again, until MET-7 is re-used over Indian Ocean
    if (NANDAT >= 20060117 and NANDAT < 20070201)
      then fail(CONSTANT); endif;
    # Blacklist MET-7 due to problem during start of Indian Ocean coverage
    if (NANDAT >= 20070212 and NANDAT <20070220)
      then fail(CONSTANT);endif;
    # Cautionary blacklist for MET-7 during decontamination
    if ( NANDAT = 20070627 and 080000 <= TIME <= 160000)
      then fail(CONSTANT); endif;
    # MET-7 blacklisted during ground segment maintenance and East West Station Keeping Manoeuvre
    if ( NANDAT > 20130513 and NANDAT < 20130521)
      then fail(CONSTANT); endif;
    # MET-7 blacklisted for retirement and replaced with MET-8
    if ( NANDAT > 20170301)
      then fail(CONSTANT); endif;
  endif;
  # MET-8
  if (SATELLITE_IDENTIFIER = 55) then
    # Cautionary blacklisting of MET-8 winds due to outage
    if (NANDAT >= 20060109 and NANDAT < 20060117)
      then fail(CONSTANT);endif;
    # Blacklisting of Met-8 due to temporary problems from wind producers
    if (NANDAT >= 20060927 and NANDAT < 20061018)
      then fail(CONSTANT);endif;
    # Retire MET-8 winds as MET-9 takes over
    # bring back Met-8 winds to replace Met-7 IODC coverage
    if (NANDAT >= 20070327 and NANDAT < 20170302) then fail(CONSTANT); endif;
    # Retire MET-8 winds again as MET-9 takes over IODC coverage
    if (NANDAT >= 20220602) then fail(CONSTANT); endif;
  endif;
  # MET-9
  if (SATELLITE_IDENTIFIER = 56) then
    # Blacklist before 20060928 when it is briefly used during MET-8 problems
    if (NANDAT < 20060928) then fail(CONSTANT); endif;
    # Blacklist MET-9 again until it becomes operational from 20070327
    if (NANDAT >= 20061018 and NANDAT < 20070327) then fail(CONSTANT); endif;
    # Temporary outage
    if (NANDAT > 20071202 and NANDAT < 20071217) then fail(CONSTANT); endif;
    # Cautionary blacklisting: Decontamination 1-9 Dec 2008
    if (NANDAT > 20081130 and NANDAT < 20081217) then fail(CONSTANT); endif;
    # Temporary outage
    if (NANDAT > 20090420 and NANDAT < 20090513) then fail(CONSTANT); endif;
    # Temporary outage
    if (NANDAT > 20110704 and NANDAT < 20110707) then fail(CONSTANT); endif;
    # Temporary blacklisting due to North-South orbit inclination manoeuvre
    if (NANDAT > 20120624 and NANDAT < 20120628) then fail(CONSTANT); endif;
    # Blacklist MET-9 low level IR and VIS CCC winds, but drop this restriction when
    # MET-9 takes over IODC
    if (NANDAT > 20120904 and NANDAT < 20220607 and RETR_TYP in (ir3,vis2) and PRESS > 700) then fail(CONSTANT); endif;
    # Retire MET-9 winds as MET-10 takes over,
    # and then bring back MET-9 for IODC coverage replacing MET-8
    if (NANDAT > 20130123 and NANDAT < 20220607) then fail(CONSTANT); endif;
  endif;
  # MET-10
  if (SATELLITE_IDENTIFIER = 57) then
    # Activation of MET-10
    if (NANDAT < 20130124) then fail(CONSTANT); endif;
    #MET-10 decontamination
    if (NANDAT >= 20130701 and NANDAT < 20130716) then fail(CONSTANT); endif;
    #MET-10 decontamination
    if (NANDAT >= 20140114 and NANDAT < 20140128) then fail(CONSTANT); endif;
    #MET-10 decontamination
    if (NANDAT >= 20141203 and NANDAT < 20141216) then fail(CONSTANT); endif;
    #MET-10 decontamination
    if (NANDAT >= 20151208 and NANDAT < 20160112) then fail(CONSTANT); endif;
    #MET-10 retired from operations
    if (NANDAT >= 20180207) then fail(CONSTANT); endif;
  endif;
  # MET-11
  if (SATELLITE_IDENTIFIER = 70) then
    # Activation of MET-11
    if (NANDAT < 20180220) then fail(CONSTANT); endif;
    #MET-11 decontamination
    if (NANDAT >= 20190121 and NANDAT < 20190207) then fail(CONSTANT); endif;
    #MET-11 decontamination
    if (NANDAT >= 20200113 and NANDAT < 20200130) then fail(CONSTANT); endif;
  endif;
  # GOES-9 (Pacific Ocean coverage)
  if (STATID = "     253") then
    # Cautionary blacklisting of new JMA GOES-9 winds
    if (NANDAT >= 20050301 and NANDAT < 20050322 ) then fail(CONSTANT); endif;
  endif;
  # GOES-10
  if (SATELLITE_IDENTIFIER = 254) then
    # Blacklisting of bad data due to temporary problems at wind producers
    if (NANDAT >= 20011205 and NANDAT < 20011212 ) then fail(CONSTANT); endif;
    # Blacklist GOES-10 winds at/after 20060621
    if (NANDAT >= 20060621) then fail(CONSTANT); endif;
  endif;
  # GOES-11
  if (SATELLITE_IDENTIFIER = 255)then
    # Start using GOES-11 winds at/after 20060817
    # GOES-11 retired from operations 20111206
    if (NANDAT < 20060817 or NANDAT > 20111205) then fail(CONSTANT); endif;
  endif;
  # GOES-12
  if (SATELLITE_IDENTIFIER = 256) then
    # Cautionary blacklisting of GOES-12 winds during decontamination
    if (NANDAT >= 20070627 and NANDAT < 20070712) then fail(CONSTANT); endif;
    # GOES-12 outage - precautionary blacklist
    if (NANDAT > 20071216 and NANDAT < 20071219) then fail(CONSTANT); endif;
    # GOES-12 outage (thruster anomaly) - precautionary blacklist
    if (NANDAT > 20081217 and NANDAT < 20090115) then fail(CONSTANT); endif;
    # GOES-12 retired from operations (GOES-13 to take over)
    if (NANDAT > 20100401) then fail(CONSTANT); endif;
  endif;
  # GOES-13
  if (SATELLITE_IDENTIFIER = 257) then
    # GOES-13 takes over operations from GOES-12
    if (NANDAT <= 20100428) then fail(CONSTANT); endif;
    #GOES-13 was passively monitored after increased noise
    if ( NANDAT >= 20120925 and NANDAT < 20121030 ) then fail(CONSTANT); endif;
    #GOES-13 set to passive monitoring after East imaging stopped
    if ( NANDAT >= 20130523 and NANDAT < 20130613) then fail(CONSTANT); endif;
    #Cautionary blacklisting of GOES-13 after introduction of hourly winds
    #Introduction of hourly winds was postponed
    if ( NANDAT > 20130728 and NANDAT < 20130807) then fail(CONSTANT); endif;
    #Cautionary blacklisting of GOES-13 after introduction of hourly winds
    if ( NANDAT > 20140505 and NANDAT < 20140514) then fail(CONSTANT); endif;
    # Blacklisting of the additional hourly GOES AMVs
    if ( NANDAT >= 20140513
        and ( 010000 <= TIME <= 025900
      or 040000 <= TIME <= 055900 or 070000 <= TIME <= 085900
             or 100000 <= TIME <= 115900 or 130000 <= TIME <= 145900
             or 160000 <= TIME <= 175900 or 190000 <= TIME <= 205900
             or 220000 <= TIME <= 235900 ) )
      then fail(CONSTANT); endif;
    # GOES-13 retired from operations (GOES-16 to take over at later date)
    if (NANDAT > 20180101) then fail(CONSTANT); endif;
  endif;
  # GOES-15
  if (SATELLITE_IDENTIFIER = 259) then
    # Activation of GOES-15
    if (NANDAT < 20120425) then fail(CONSTANT); endif;
    # GOES-15 will be passively monitored after Yaw Flip Maneuver
    if ( NANDAT >= 20120920 and NANDAT < 20120925 ) then fail(CONSTANT); endif;
    # GOES-15 will be passively monitored after Yaw Flip Maneuver
    if ( NANDAT >= 20130320 and NANDAT < 20130326 ) then fail(CONSTANT); endif;
    #Cautionary blacklisting of GOES-15 after introduction of hourly winds
    #Introduction of hourly winds was postponed
    if ( NANDAT > 20130728 and NANDAT < 20130807) then fail(CONSTANT); endif;
    #Cautionary blacklisting of GOES-15 after introduction of hourly winds
    if ( NANDAT > 20140505 and NANDAT < 20140514 ) then fail(CONSTANT); endif;
    # Blacklisting of the additional hourly GOES AMVs
    if ( NANDAT >= 20140513
        and ( 010000 <= TIME <= 025900
      or 040000 <= TIME <= 055900 or 070000 <= TIME <= 085900
             or 100000 <= TIME <= 115900 or 130000 <= TIME <= 145900
             or 160000 <= TIME <= 175900 or 190000 <= TIME <= 205900
             or 220000 <= TIME <= 235900 ) )
      then fail(CONSTANT); endif;
    #Cautionary blacklisting of GOES-15 during orbit drift 135W to 128W
    if ( NANDAT > 20181022 and NANDAT < 20181115 ) then fail(CONSTANT); endif;
    #Retire GOES-15 and move to GOES-17
    if ( NANDAT > 20191209 ) then fail(CONSTANT); endif;
  endif;
  # GOES-16
  if (SATELLITE_IDENTIFIER = 270) then
    # Activation of GOES-16
    if (NANDAT < 20180522) then fail(CONSTANT); endif;
  endif;
  # GOES-17
  if (SATELLITE_IDENTIFIER = 271) then
    # Activation of GOES-17
    if (NANDAT < 20191210) then fail(CONSTANT); endif;
    # Time screening between 9 and 17Z
    if ( 090000 < TIME < 170000 )
      then fail(CONSTANT); endif;
  endif;
  # MTSAT-1R
  if (SATELLITE_IDENTIFIER = 171) then
    # Cautionary blacklisting of MTSAT-1R winds after processing change at JMA
    if (NANDAT >= 20070530 and NANDAT < 20070619)
      then fail(CONSTANT); endif;
    # Cautionary blacklisting: Decontamination 17 Feb 2009
    if (NANDAT > 20090216 and NANDAT < 20090226)
      then fail(CONSTANT); endif;
    # Cautionary blacklisting: New JMA height assignment on 19 May 2009
    if ( NANDAT > 20090518 and NANDAT < 20090622 ) then fail(CONSTANT); endif;
    # Blacklisting of the additional 3-hourly MTSAT AMVs
    if ( NANDAT > 20090816 and NANDAT < 20111108
        and ( 020000 < TIME < 040000 or 080000 < TIME < 100000
             or 140000 < TIME < 160000 or 200000 < TIME < 220000 ) )
      then fail(CONSTANT); endif;
    # Temporary outtage for MTSAT-1R : Ground Segment issue
    if (NANDAT > 20091123 and NANDAT < 20091208 ) then fail(CONSTANT); endif;
    # MTSAT-1R retired from operations, but continued as backup for MTSAT-2 during the ground processing failure
    if (NANDAT > 20100810 and NANDAT < 20101027 ) then fail(CONSTANT); endif;
    # MTSAT-1R retired from operations, but continued as backup for MTSAT-2 during ground system maintenance
    if (NANDAT > 20101221 and NANDAT < 20111108) then fail(CONSTANT); endif;
    # IR winds north of 20N blacklisted due to large OmB and OmA differences
    if RETR_TYP in (ir) and ( LAT >= 20 ) and (NANDAT > 20111107)
    then fail(CONSTANT); endif;
    # MTSAT-1R retired from operations, but continued as backup for MTSAT-2 during ground system maintenance
    if ( NANDAT > 20111222 and NANDAT < 20121030) then fail(CONSTANT); endif;
    # MTSAT-1R retired from operations, but continued as backup for MTSAT-2 during ground system maintenance
    if ( NANDAT > 20121217 and NANDAT < 20131031) then fail(CONSTANT); endif;
    # MTSAT-1R retired from operations
    if ( NANDAT > 20131216) then fail(CONSTANT); endif;
  endif;
  # MTSAT-2
  if (SATELLITE_IDENTIFIER = 172) then
    # Blacklist MTSAT-2 until AMVs take over operations from MTSAT-1R
    if (NANDAT <= 20100810) then fail(CONSTANT); endif;
    # Cautionary blacklisting after ground processing failure
    if (NANDAT > 20101012 and NANDAT < 20110111) then fail(CONSTANT); endif;
    # MTSAT-2 back in operations but ir winds north of 20N blacklisted due to large OmB and OmA differences
    if RETR_TYP in (ir) and ( LAT >= 20 ) and (NANDAT > 20110110)
    then fail(CONSTANT); endif;
    # MTSAT-2 starts hourly dissemination of AMVs 28th March 2011, data is blacklisted until the quality has been checked
    # MTSAT-2 AMVs reactivated 23rd August 2011
    if (NANDAT > 20110327 and NANDAT < 20110823) then fail(CONSTANT); endif;
    # Blacklist MTSAT-2 due to ground system maintenance
    if (NANDAT > 20111031 and NANDAT < 20120110) then fail(CONSTANT); endif;
    # Blacklist 00.15, 06.15, 12.15 and 18.15 UTC files due to suspicious OmB statistics
    if ( NANDAT > 20120109
          and ( 001000 < TIME < 002000 or 061000 < TIME < 062000
               or 121000 < TIME < 122000 or 181000 < TIME < 182000 ) )
        then fail(CONSTANT); endif;
    # Blacklist MTSAT-2 data due to satellite maintainance
    if (NANDAT > 20121017 and NANDAT < 20130115) then fail(CONSTANT); endif;
    # Blacklist MTSAT-2 data due to north-south station-keeping maneuver
    if (NANDAT > 20130623 and NANDAT < 20130729) then fail(CONSTANT); endif;
    # Blacklist MTSAT-2 data due to satellite ground system maintenance
    if (NANDAT > 20131021 and NANDAT < 20140114) then fail(CONSTANT); endif;
    # Blacklist MTSAT-2 data due to satellite ground system maintenance
    if (NANDAT > 20141106 and NANDAT < 20141216) then fail(CONSTANT); endif;
    # MTSAT-2 retired after switch to Himawari-8
    if (NANDAT > 20160314) then fail(CONSTANT); endif;
  endif;
  # HIMAWARI-8
  if (SATELLITE_IDENTIFIER = 173) then
    # Blacklist Himawari-8 until AMVs take over operations from MTSAT-2
    if (NANDAT <= 20160314) then fail(CONSTANT); endif;
  endif;
  # MODIS winds from Terra and Aqua...
  # ... from CIMSS (temporarily distinguised through their satellite ID)
  if SATELLITE_IDENTIFIER in (773, 774) then
    # blacklist CIMSS winds at/after 20040817
    if (NANDAT >= 20040817 ) then fail(CONSTANT); endif;
  endif;
  # ... from NOAA
  if SATELLITE_IDENTIFIER in (783, 784) then
    # Blacklist direct broadcast MODIS AMVs (simplify?)
    if DATASTREAM = dbmodis or GEN_CENTRE = 176 then fail(CONSTANT); endif;
    # blacklist NOAA winds before 20040817
    if SATELLITE_IDENTIFIER in (783, 784) and (NANDAT < 20040817 )
      then fail(CONSTANT); endif;
    # blacklist Terra MODIS winds due to increased striping in the images
    if SATELLITE_IDENTIFIER in (783) and (NANDAT > 20130728 )
      then fail(CONSTANT); endif;
    # blacklist Aqua MODIS winds, due to a decoder problem
    if SATELLITE_IDENTIFIER in (784) and (NANDAT > 20140526 and NANDAT < 20140604)
      then fail(CONSTANT); endif;
  endif;
  # AVHRR winds from NOAA-15, -16, -18 satellites
  if (SATELLITE_IDENTIFIER in (206, 207, 209)) then
    # Activation of AVHRR winds
    if (NANDAT < 20121119) then fail(CONSTANT); endif;
  endif;
  # AVHRR winds from NOAA-19 satellite
  if (SATELLITE_IDENTIFIER in (223)) then
    # Activation of NOAA-19 AVHRR winds
    if (NANDAT < 20130827) then fail(CONSTANT); endif;
  endif;
  if (SATELLITE_IDENTIFIER in (206)) then
    # NOAA-15
    if (NANDAT > 20140609 and NANDAT < 20140616) then fail(CONSTANT); endif;
    # Prevent potential bad data after failure of scan motor
    if (NANDAT > 20190731 and NANDAT < 20190925) then fail(CONSTANT); endif;
  endif;
  if (SATELLITE_IDENTIFIER in (207)) then
    # NOAA-16 is not available anymore
    if (NANDAT >= 20140616) then fail(CONSTANT); endif;
  endif;
  if (SATELLITE_IDENTIFIER in (3,4)) then
    # Activation of single Metop-A and Metop-B AMVs
    if (NANDAT < 20160204) then fail(CONSTANT); endif;
  endif;
  if (SATELLITE_IDENTIFIER in (4)) then
    # De-activate Metop-A AMVs just before end-of-life
    if (NANDAT > 20211110) then fail(CONSTANT); endif;
  endif;
  if (SATELLITE_IDENTIFIER in (852)) then
    # Activation of dual Metop-A/B AMVs
    if (NANDAT < 20160204) then fail(CONSTANT); endif;
  endif;
  if (SATELLITE_IDENTIFIER in (224)) then
    # Activation of SNPP VIIRS AMVs
    if (NANDAT < 20160811) then fail(CONSTANT); endif;
  endif;
  if (SATELLITE_IDENTIFIER in (225)) then
    # Activation of NOAA-20 VIIRS AMVs
    if (NANDAT < 20200513) then fail(CONSTANT); endif;
  endif;
  if (SATELLITE_IDENTIFIER in (5)) then
    # Activation of Metop-C AMVs
    if (NANDAT < 20190625) then fail(CONSTANT); endif;
  endif;
  # Solar stray-light blacklisting for MET-5 and -7
  #================================================
  # exclude data at special times (solar stray light effects), based on month+day, obs time
  if (SATELLITE_IDENTIFIER in (54) and (NANDAT < 20070201)) then
    if ( (TIME > 230000) or (TIME <= 003000) ) then
      if ( (NANDAT%10000 >= 0215) and (NANDAT%10000 <= 0521) ) then fail(CONSTANT); endif;
      if ( (NANDAT%10000 >= 0724) and (NANDAT%10000 <= 1222) ) then fail(CONSTANT); endif;
    endif;
    if ( (TIME > 003000) and (TIME < 020000) ) then fail(CONSTANT); endif;
    if ( (TIME >= 020000) and (TIME < 030000) ) then
      if ( (NANDAT%10000 >= 0120) and (NANDAT%10000 <= 0521) ) then fail(CONSTANT); endif;
      if ( (NANDAT%10000 >= 0726) and (NANDAT%10000 <= 1130) ) then fail(CONSTANT); endif;
    endif;
    if ( (TIME >= 030000 ) and ( TIME <= 033000) ) then
      if ( (NANDAT%10000 >= 0126) and (NANDAT%10000 <= 0420) ) then fail(CONSTANT); endif;
      if ( (NANDAT%10000 >= 0827) and (NANDAT%10000 <= 1028) ) then fail(CONSTANT); endif;
    endif;
  endif;
  if (SATELLITE_IDENTIFIER in (52) or (SATELLITE_IDENTIFIER in (54) and (NANDAT >= 20070201)))then
    if ( (TIME > 190000) and (TIME <= 203000) ) then
      if ( (NANDAT%10000 >= 0215) and (NANDAT%10000 <= 0521) ) then fail(CONSTANT); endif;
      if ( (NANDAT%10000 >= 0724) and (NANDAT%10000 <= 1222) ) then fail(CONSTANT); endif;
    endif;
    if ( (TIME > 203000) and (TIME < 213000) ) then fail(CONSTANT); endif;
    if ( (TIME >= 213000) and (TIME < 230000) ) then
      if ( (NANDAT%10000 >= 0120) and (NANDAT%10000 <= 0521) ) then fail(CONSTANT); endif;
      if ( (NANDAT%10000 >= 0726) and (NANDAT%10000 <= 1130) ) then fail(CONSTANT); endif;
    endif;
    if ( (TIME >= 230000 ) and ( TIME <= 233000) ) then
      if ( (NANDAT%10000 >= 0126) and (NANDAT%10000 <= 0420) ) then fail(CONSTANT); endif;
      if ( (NANDAT%10000 >= 0827) and (NANDAT%10000 <= 1028) ) then fail(CONSTANT); endif;
    endif;
  endif;
elif (OBSTYP = limb) then
  # New GPS-RO whitelist (sbh 30-3-2011)
  if SATELLITE_IDENTIFIER notin (41,722,4,42,820,786,740,741,742,743,744,745,3,43,522,5,825,
                                 750, 751, 752, 753, 754, 755, 269, 66, 803)
  then fail(CONSTANT); endif;
 # Sentinel6-a and GRACE-C blacklist. Operational on January 13, 2022.
  if SATELLITE_IDENTIFIER in (66, 803) then
    if ( NANDAT < 20220113 ) then fail(CONSTANT); endif;
  endif;
  # Sentinel6-a and GRACE-C blacklist
  # remove biased bending angles above 30 km
  if SATELLITE_IDENTIFIER in (66, 803) then
    if (press > 30000.0) then fail(CONSTANT); endif;
  endif;
  # Spire blacklist. Operational May 13 to Sep 30, 2020.
  if SATELLITE_IDENTIFIER in (269) then
    if ( NANDAT < 20200513 ) then fail(CONSTANT); endif;
    if (( NANDAT > 20200930 ) and ( NANDAT < 20220607) ) then fail(CONSTANT); endif;
  endif;
  # COSMIC2 blacklist. Operational on March 25, 2020.
  if SATELLITE_IDENTIFIER in (750, 751, 752, 753, 754, 755) then
    if ( NANDAT < 20200325 ) then fail(CONSTANT); endif;
  endif;
  # FY-3C GNOS blacklist
  if SATELLITE_IDENTIFIER in (522) then
    if ( NANDAT < 20180306 ) then fail(CONSTANT); endif;
  # remove all data below 8 km
    if (press < 8000.0) then fail(CONSTANT); endif;
    # remove biased bending angles in tropics
    if ((LAT > -20) and (LAT < 20) and (press < 10000.0)) then fail(CONSTANT); endif;
    if ( (NANDAT > 20180326) and (NANDAT < 20180411) ) then fail(CONSTANT); endif;
  endif;
  # champ blacklist
  if SATELLITE_IDENTIFIER in (41) then
    if ( NANDAT < 20060821 ) then fail(CONSTANT); endif;
    if ( NANDAT > 20070204 ) then fail(CONSTANT); endif;
  endif;
  # GRACE-A blacklist
  if SATELLITE_IDENTIFIER in (722) then
    if ( NANDAT < 20060821 ) then fail(CONSTANT); endif;
    if ( (NANDAT > 20070204 ) and (NANDAT < 20110405 )) then fail(CONSTANT); endif;
  endif;
  # blacklist TerraSAR-X
  if SATELLITE_IDENTIFIER in (42) then
    if (NANDAT < 20110405 ) then fail(CONSTANT); endif;
  endif;
  # blacklist TerraSAR-X and Tandem-X before June 11, 2015
  if SATELLITE_IDENTIFIER in (42,43) then
    if (NANDAT < 20150611 ) then fail(CONSTANT); endif;
  endif;
  # blacklist SAC-C and C-NOFS
  if SATELLITE_IDENTIFIER in (820,786) then fail(CONSTANT); endif;
  # check QC flags
  if ( NANDAT < 20081204) then
    # don't check GRAS flags before date given above 
    if SATELLITE_IDENTIFIER notin (4) then
      if RETR_TYP in (2) then fail(CONSTANT); endif;
    endif;
  else
# don't check flags for kompsat-5
    if SATELLITE_IDENTIFIER notin (825) then
      if RETR_TYP in (2) then fail(CONSTANT); endif;
    endif;
  endif;
# kompsat-5 flags
  if SATELLITE_IDENTIFIER in (825) then
    if ( NANDAT < 20190724 ) then fail(CONSTANT); endif;
# reject rising below 15 km
    if (RETR_TYP notin (0)) and (press < 15000.0) then fail(CONSTANT); endif;
  endif;
  # metop-c gras blacklist
  if SATELLITE_IDENTIFIER in (5) then
    if ( NANDAT < 20190314 ) then fail(CONSTANT); endif;
  endif;
  # metop-b gras blacklist
  if SATELLITE_IDENTIFIER in (3) then
    if ( NANDAT < 20130522 ) then fail(CONSTANT); endif;
  endif;
  # blacklist METOP A+B GRAS measurements
  if SATELLITE_IDENTIFIER in (4,3) then
    if ( NANDAT < 20080520 ) then fail(CONSTANT); endif;
    # active assimilation of tropospheric GRAS data, June 7, 2017
    if ( NANDAT < 20170607 ) then
      # remove all data below 8 km
      if (press < 8000.0) then fail(CONSTANT); endif;
      # remove biased bending angles in tropics
      if ((LAT > -20) and (LAT < 20) and (press < 10000.0)) then fail(CONSTANT); endif;
    endif;
  endif;
  # blacklist bending angles above 50 km
  if (NANDAT >= 20070918 and press > 50000.0) then fail(CONSTANT); endif;
  # blacklist Metop-A GRAS for parameter update on June 25, 2013
  if SATELLITE_IDENTIFIER in (4) then
    if ((NANDAT > 20130623) and (NANDAT < 20130703)) then fail(CONSTANT); endif;
  endif;
#----------------- GROUND-BASED RADAR COMPOSITE DATA SELECTION ------------------
elif (OBSTYP = gbrad) then
  if VARIAB notin (lnprc) then fail(CONSTANT); endif;
elif (OBSTYP = raingg) then
  if VARIAB notin (lnprc) then fail(CONSTANT); endif;
  if (VARIAB in (lnprc)) and (LAT > -25) and (LAT < 25) then fail(CONSTANT); endif;
#----------------------- LIDAR CONSTANT DATA SELECTION -------------------
elif (OBSTYP = lidar) then
  # Remove if not Aeolus HLOS obs (only obstype LIDAR data at moment)
  if VARIAB notin (hlos) then fail(CONSTANT); endif;
  # Blacklist Aeolus Mie-clear winds
  if RETR_TYP in (1) then fail(CONSTANT); endif;
  # Blacklist Aeolus Rayleigh-cloudy winds
  if RETR_TYP in (4) then fail(CONSTANT); endif;
  # Check observation error size
  # Blacklist Mie-cloudy if observation error (m/s) too large (assuming 1.75 scaling factor)
  if ((RETR_TYP in (2)) and (OBS_ERROR > 8.75)) then fail(CONSTANT); endif;
  # Blacklist Rayleigh-clear if observation error (m/s) too large (as function of pressure (hPa))
  # Assuming 1.4 scaling factor
  if ((RETR_TYP in (3)) and (OBS_ERROR > 17.0) and ( PRESS <= 200 )) then fail(CONSTANT); endif;
  if ((RETR_TYP in (3)) and (OBS_ERROR > 12.0) and ( PRESS > 200 )) then fail(CONSTANT); endif;
  # avoid if within roughly 250 m (~20 hPa of surface)
  if (PRESS > MODPS - 20) then fail(CONSTANT); endif;
  # avoid data at low altitudes, i.e. below 850 hPa, for Rayleigh-clear
  if ((RETR_TYP in (3)) and (PRESS > 850)) then fail(CONSTANT); endif;
  # Date for operational usage
  if (NANDAT < 20200109) then fail(CONSTANT); endif;
  # Reject Aeolus during a transition in bias properties due to M1 T bias correction
  if (NANDAT >= 20200420 and NANDAT <= 20200423) then fail(CONSTANT); endif;
  # Reject Aeolus during an Instrument Telescope Refocus (ITR)
  if (NANDAT >= 20200525 and NANDAT <= 20200529) then fail(CONSTANT); endif;
  # Reject Aeolus during a test of new M1 temperature thermal control settings
  if (NANDAT >= 20200706 and NANDAT <= 20200710) then fail(CONSTANT); endif;
  # Reject Aeolus during a (potentially) 3 week FM-B laser sensitivity test period
  if (NANDAT >= 20200921 and NANDAT <= 20201009) then fail(CONSTANT); endif;
else
  fail(CONSTANT); # Unknown obstype
endif;
#
# MONTHLY monitoring:
#
#--------------------- SCAT CONSTANT DATA SELECTION -----------------
# Monthly blacklisting for SCAT only ----------------------------
if (OBSTYP = scatt) then
   # exit ERS and QuikSCAT blacklist scatterometer here
return; endif;
# Monthly blacklisting for SATELLITE RADIANCES AND RETRIEVALS ---
if (OBSTYP = satem) then
   # exit blacklist processing here
return; endif;
# Monthly blacklisting for SATOBs only --------------------------
if (OBSTYP = satob) then
   # exit blacklist processing here
return; endif;
# Monthly blacklisting for SYNOPs only --------------------------
if ( OBSTYP = synop ) then
   if VARIAB in ( u10m, v10m )
   and STATID in ( "    3FZM","    4XGU","    8PNK","    8PNN","    9MBQ",
                    "    9MBW","    9MUG","    9VBK","    9VIG","    9VVI",
                    "    9VVS","    9VVW","    A9DG","    BHFN","    CYLY",
                    "    DANR","    DEHY","    DGSR","    DJQR","    DPGD",
                    "    DPNF","    DUHN","    EIDX","    FGTO","    FHZI",
                    "    FNAT","    FNVA","    H3QM","    HPEW","    HZZC",
                    "    JNCI","    KGTX","    OUGV","    PBFC","    PFAS",
                    "    PHIA","    PJIB","    PJJU","    PJOD","    PPSO",
                    "    S6TY","    SFRZ","    SXYY","    SYMK","    TEST",
                    "    UBAW","    UBDL","    UBLH","    UCDN","    UCTA",
                    "    UCTK","    UCUF","    UCUO","    UDUR","    UEFE",
                    "    UFXA","    UGGA","    UGWB","    UHOM","    UIAG",
                    "    UIAI","    UIRN","    V2FM","    VCLM","    VCPZ",
                    "    VCRT","    VCTJ","    VCTM","    VGFJ","    VGLZ",
                    "    VGRT","    VLKG","    VRUR","    VTXK","    VTXL",
                    "    WGJF","    WNPD","    WUQL","   3EHN2","   3EJB9",
                    "   3ETH4","   3FAP5","   3FEI6","   3FMM6","   44145",
                    "   46131","   46181","   62106","   62131","   62166",
                    "   62414","   9HWA5","   9MBK8","   9MBR8","   9WCY2",
                    "   A8BJ9","   C6KD7","   C6LU4","   C6MS4","   C6MX4",
                    "   C6NI3","   C6NI7","   C6RN8","   ELOV9","   ELPT3",
                    "   ELQB8","   ELRO2","   ELVY4","   ELWG7","   ELWZ3",
                    "   ELXT8","   KS000","   KS002","   KS004","   KS012",
                    "   KS025","   LAEP4","   LAJV4","   LAVX4","   LAWO2",
                    "   MJCE3","   MTBF3","   MVXQ8","   OUJH2","   OWEB2",
                    "   OWEN2","   OWFU2","   OWVI2","   OXQP2","   P3AT9",
                    "   P3EK7","   P3KH8","   P3ZY6","   V2AF1","   V2AQ3",
                    "   V2EA4","   V7AP8","   V7DR6","   VRUM3","   ZCBD3",
                    "   ZCBF3","   ZCDA9","  DGCDFD"," WAQ2746"," WBD5759",
                    " WCW9126"," WYH6327")
   then fail(); endif;
   if VARIAB in ( z, ps )
   and STATID in ( "    0210","    4XGS","    4XGU","    4XGV","    4XGW",
                    "    8PNI","    9KWK","    9MBR","    9MBW","    9VIG",
                    "    9VRA","    9VVD","    9VVN","    9VVS","    9VVW",
                    "    BHFN","    BOAB","    C6JP","    C6OT","    C6QK",
                    "    C6YW","    CGCX","    CGDX","    CGJV","    CTFD",
                    "    CYGR","    CYLX","    D5XH","    DANR","    DBBI",
                    "    DEBB","    DEOF","    DGKV","    DILE","    DQVG",
                    "    DQVL","    EIDX","    FGAK","    GQVM","    GRFP",
                    "    GXEV","    GXHN","    H3EP","    H3GQ","    H9IL",
                    "    JGQU","    JNVU","    KAKF","    KCGH","    KGBE",
                    "    KGTX","    KGTZ","    KHRC","    KHRH","    KHRP",
                    "    KMJL","    KRGB","    OUEW","    OWME","    OXDK",
                    "    OZLB","    PBFM","    PCEX","    PCZM","    PDLF",
                    "    PDYX","    PDZR","    PEAJ","    PECF","    PEXU",
                    "    PGHT","    PHKL","    PHQW","    PJMJ","    RIGG",
                    "    S6JQ","    S6JR","    S6JS","    SCFH","    SGIX",
                    "    SHIP","    SXVF","    SYMK","    SYQI","    TEST",
                    "    TSLN","    UACU","    UAIR","    UANA","    UANF",
                    "    UASP","    UASU","    UBAU","    UBAW","    UBDA",
                    "    UBDL","    UBDP","    UBNY","    UBXP","    UBXS",
                    "    UCAB","    UCAC","    UCAD","    UCCR","    UCCZ",
                    "    UCJB","    UCJE","    UCJL","    UCKC","    UCOQ",
                    "    UCOY","    UCTA","    UCTI","    UCTK","    UCTN",
                    "    UCTP","    UCTQ","    UCUC","    UCUD","    UCUE",
                    "    UCUF","    UCUO","    UCUP","    UDBK","    UDUK",
                    "    UDWE","    UDWH","    UEFE","    UFAA","    UFEQ",
                    "    UFJJ","    UFNO","    UFVZ","    UGGA","    UGNQ",
                    "    UGSI","    UHCE","    UHLE","    UHPO","    UHWM",
                    "    UIAG","    UIAI","    UICO","    UIRN","    UITJ",
                    "    UITP","    UIZE","    V2MH","    V2PQ","    V2XO",
                    "    VCDT","    VCJM","    VCJW","    VCPK","    VCPX",
                    "    VCQM","    VCRQ","    VCRT","    VCTD","    VCTJ",
                    "    VCTM","    VCTV","    VCTX","    VDLC","    VGDX",
                    "    VGFQ","    VGJC","    VGKM","    VGQC","    VGRT",
                    "    VGSS","    VJNV","    VMGO","    VNVS","    VOSN",
