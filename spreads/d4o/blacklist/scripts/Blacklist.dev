# External variables (non-special, i.e. related to obs. header & model fields)
external hdr.obstype; # 1) = 'OBSTYP' # observation type

# External variables (SPECIAL, i.e. related to obs. body entry only)
external body.varno is SPECIAL; # 1) = 'VARIAB' # variable name


#
# CONSTANT Section:
# - selection of analysis variables
# - 'constant' setup for use of observations
# - cycle-dependent satellite data blacklisting
#
#----------------------- SYNOP CONSTANT DATA SELECTION ----------------------
if (hdr.OBSTYPE = ralt) then
  fail(CONSTANT);
elif (hdr.obstype = synop) then
  if body.varno notin (u10m, v10m, rh2m, ps, z) then fail(CONSTANT); endif;
  #  if (LAT = 0 and LON=0) then fail(CONSTANT); endif;
return; endif;
# Do not add any rule here, because this part of the
# blacklist is never processed. Monthly rules must be put into the
# relevant if (OBSTYP = ... ) ... return; endif; construct above.
