module purge
module load cmake/3.17.3
module load intel20.1/20.1.217
module load intel20.1/szip/2.1.1
module load curl/7.70.0
module load impi20.1/19.7.217
module load anaconda/3.9 # gives access to python 3
module load dbi/1.643
module load sqlite/3.38.0
module load dbd-sqlite/1.70
module load gcc_9.1.0
export TBBMALLOC_DIR=$TBBROOT/lib/intel64/gcc4.8
if [[ -d $TBBMALLOC_DIR ]] ; then
    export LD_LIBRARY_PATH="${TBBMALLOC_DIR}:$LD_LIBRARY_PATH"
    export TBB_MALLOC_USE_HUGE_PAGES=1 # TBB: Use huge pages (if available)
#    export TBB_MALLOC_SET_HUGE_SIZE_THRESHOLD=0 # Cache large objects from 
else
    unset TBBMALLOC_DIR
fi
module -t list

