&OutputProcessing();

$debug = $args->{debug};
$verbose = $args->{verbose};
$progress = $args->{progress};
$suppress = $args->{suppress};
$dbi_profile = $args->{dbi_profile};
$batch = $args->{batch};
$keep = $args->{keep};
$status_field = $args->{status_field};
$final = $args->{final};
$allsky = $args->{allsky};
$backup = $args->{backup};
$bailout = $args->{bailout};
$deferens = $args->{deferens};
$col_filter = $args->{col_filter};
$delete_tmp_odc = $args->{delete_tmp_odc}; # if > 0, deletes any newly created (from BUFR) ODC-files (and tmp SQLite-databases) once d4o created
$deterministic = $args->{deterministic};
$obs_error_variance = $args->{obs_error_variance};
$obs_error_variance = $obs_error_variance_default if (defined($obs_error_variance) && $obs_error_variance <= 0);
$inflate = $args->{inflate};
if ($inflate == 0) {
    $inflate_factor = 1;
}
else {
    $inflate_factor = (100.0+$inflate)/100.0;
}
$pathodc = $args->{pathodc};
if (defined($args->{tmpdir})) {
    $tmpdir = $args->{tmpdir};
    qx(mkdir -p $tmpdir) unless (-d $tmpdir);
    $ENV{"TMPDIR"} = $tmpdir;
    $ENV{"SQLITE_TMPDIR"} = $tmpdir;
}

our $report_once_eval_error_MatchKind = 1;
our @target_kinds = (); # a subset of targets
if (defined($args->{target_kinds})) {
    my $target_kinds = $args->{target_kinds};
    $target_kinds =~ s/\s+//;
    $target_kinds =~ s/^,//;
    $target_kinds =~ s/,$//;
    my %taken = ();
    for (split(/,/,$target_kinds)) {
	if (m{^(\d+)$}) {
	    my $kind = $1;
	    push(@target_kinds,$kind), $taken{$kind} = 1 unless (exists($taken{$kind}));
	}
	elsif (m{^(\d+)-(\d+)$}) { # a range
	    my ($lo,$hi) = ($1,$2);
	    next if ($lo > $hi);
	    for my $kind ($lo..$hi) {
		push(@target_kinds,$kind), $taken{$kind} = 1 unless (exists($taken{$kind}));
	    }
	}
    }
    @target_kinds = &NumSortUniq(@target_kinds);
}

# run d4osplit embedded ? this will be reset to no-op if no timeslots found (e.g. when no --basetime option provided)
@split = ();
if (defined($args->{psplit})) {
    $psplit = 1;
    unless (defined($args->{split})) {
	$args->{split} = $args->{psplit};
    }
    else {
	$args->{split} .= sprintf(",%s",$args->{psplit});
    }
    $args->{psplit} = undef;
}
if (defined($args->{split})) {
    my $split = $args->{split};
    $split =~ s/\s+//;
    $split =~ s/^,//;
    $split =~ s/,$//;
    my %taken = ();
    for (split(/,/,$split)) {
	if (m{^(\d+)$}) {
	    my $ts = $1;
	    push(@split,$ts), $taken{$ts} = 1 unless (exists($taken{$ts}));
	}
	elsif (m{^(\d+)-(\d+)$}) { # a range
	    my ($lo,$hi) = ($1,$2);
	    next if ($lo > $hi);
	    for my $ts ($lo..$hi) {
		push(@split,$ts), $taken{$ts} = 1 unless (exists($taken{$ts}));
	    }
	}
    }
    @split = &NumSortUniq(@split);
}

# Map d4o columns to ODC in &Mapper()

our @tblmapper = ();
our %exprmapper = ();
our %colmapper = (); # A fully qualified d4o column refers to one or more ODC (short) columns
our %d4omapper = (); # ODC short column name reference may be present in none, or usually one or more d4o columns e.g. see d4o "lat" := ODC radians(lat)
our @odc_col_filter_default = ();
our ($odc_row_filter,$odc_row_chunk) = (undef,undef);
our ($bufr_range,$bufr_first_msg,$bufr_last_msg) = (undef,undef,undef);

$thinning = $args->{thinning};
$thinning = 1 unless ($thinning > 1);

$gpsro_refrac = $args->{gpsro_refrac}; # if == 1, then BUFR input will be piped thru the "gpsro_refrac"-script rather than via "b2o" and tmp ODC
our $gpsro_refrac_scr = sprintf("%s/gpsro_refrac",$cmddir);

&Mapper(); # always call Mapper to get (kind,description) <=> (obstype,codetype,....) right + generate ODC_ROW_FILTER (on top of user requested)

# Get status bits as per defined in status_bits.F90(.txt)
our $status_bits = undef;
our %status_bits = ();
our $status_bits_file = undef;
$status_bits_file = sprintf("./status_bits.F90.txt") unless (defined($status_bits_file)); # current dir (rare)
$status_bits_file = sprintf("%s/status_bits.F90.txt",$incdir) unless (-r $status_bits_file); # installation dir (most likely)
$status_bits_file = sprintf("%s/status_bits.F90.txt",$cmddir) unless (-r $status_bits_file); # scripts dir (rare)

unless (-r $status_bits_file) {
    printf(STDERR "Warning: status bits definition file '%s' not found -- table(s) status fields will be incorrect for non-active obs\n",&BaseName($status_bits_file));
}
else {
    open(IN,"< $status_bits_file") || die "Unable to open an existing status bits definition file '$status_bits_file' for reading";
    my @in = <IN>;
    close(IN);
    for (@in) {
	chomp;
	if (m/^\s*&\s+\S'(\S+)\s*=\s*(\d+)-bit'/) {
	    my ($name,$bitno) = (lc($1),$2);
	    unless ($name =~ m/unused/) {
		$status_bits{$name} = $bitno;
		my $value = (1<<$bitno);
		my $pattern = sprintf("%53.53b",$value);
		$status_bits->{$name} = sprintf("%d:%d:%s",$bitno,$value,$pattern);
	    }
	}
    }
}

# Get Dart obs kinds available for this run

if (defined($args->{obs_kind})) {
    $obs_kind = $args->{obs_kind};
}
elsif ($args->{camfv}) {
    $obs_kind = "camfv";
}
elsif ($args->{clm}) {
    $obs_kind = "clm";
}
elsif ($args->{anykind}) {
    $obs_kind = "anykind";
    $anykind = 1;
    $report_once_eval_error_MatchKind = 0; # prevents &MatchKind() for doing any searches
}

if (defined($obs_kind)) {
    $obs_kind = lc($obs_kind);
    $obs_kind =~ s/-//g; # e.g. cam-fv becomes camfv
#    unless ($obs_kind =~ m{camfv|clm}) {
#	die "Illegal --obs_kind=$obs_kind supplied : must be --obs_kind=camfv (--camfv) or --obs_kind=clm (--clm)";
#    }
}
else {
    die "The obs_kind not defined : use one of the options --camfv (--obs_kind=camfv) or --clm (--obs_kind=clm)";  
}

our $obs_kind_mod = sprintf("./obs_kind_mod.F90.%s",$obs_kind); # current dir (rare)
$obs_kind_mod = sprintf("%s/obs_kind_mod.F90.%s",$incdir,$obs_kind) unless (-r $obs_kind_mod); # installation dir (most likely)
$obs_kind_mod = sprintf("%s/obs_kind_mod.F90.%s",$cmddir,$obs_kind) unless (-r $obs_kind_mod); # scripts dir (rare)

unless (-r $obs_kind_mod) {
    die sprintf("Unable to locate file '%s' related to option --obs_kind=%s",$obs_kind_mod,$obs_kind);
}

$nokindmap = $args->{nokindmap};
$kindmap = $args->{kindmap};

our $obs_kind_map = undef;
unless ($nokindmap) {
    $obs_kind_map = $kindmap if (defined($kindmap) && -r $kindmap);
    $obs_kind_map = sprintf("./kindmap.%s.txt",$obs_kind) unless (defined($obs_kind_map)); # current dir (rare)
    $obs_kind_map = sprintf("%s/kindmap.%s.txt",$incdir,$obs_kind) unless (-r $obs_kind_map); # installation dir (most likely)
    $obs_kind_map = sprintf("%s/kindmap.%s.txt",$cmddir,$obs_kind) unless (-r $obs_kind_map); # scripts dir (rare)
    $obs_kind_map = undef unless (-r $obs_kind_map); # forget about this -- may lead to failures since no "kinds" will be recognized in b2o -> ODC -> d4o conversion
}
else {
    $kindmap = undef;
}

unless (defined($obs_kind_map)) {
    printf($ERR "Warning: obs kind map file (%s) not defined/not found -- conversion to d4o-database may not work correctly\n",
	   defined($kindmap) ? sprintf("%s",$kindmap) : sprintf("kindmap.%s.txt",$obs_kind));
}

our %kind2d = (); # kind (value) to description (name)
our %d2kind = (); # description (name) to kind (value)
our %perlidx = (); # colvar to idx
our %where = (); # key = kind => value = wherecond;perlcond;perleval
our %hits = (); # hit count for %where's in MatchKind()  -- a source of undeterministic assignment of kind's
our @wherekinds = (); # numerical order of kinds to be searched used if --deterministic (leads to slower execution time in MatchKind())
our ($maxkinds,$maxdlen) = &InputDARTkinds($obs_kind_mod,$obs_kind_map);

if ($progress || $debug || $verbose) {
    for my $kind (sort { $a <=> $b } keys %kind2d) {
	my $descr = $kind2d{$kind};
	my $filter = exists($where{$kind}) ? $where{$kind} : ";";
	my ($wherecond,$perlcond,$perleval) = split(/\;/,$filter);
	my $len = length($wherecond);
	if ($len > 0) {
	    printf($ERR "InputDARTkinds(%s,%s) : %4d => %*s : %s\n",$obs_kind_mod,
		   defined($obs_kind_map) ? $obs_kind_map : "<undef>",
		   $kind,$maxdlen,$descr,
		   $wherecond);
	}
    }
}

if (keys %where) {
    my @whereconds = ();
    for my $kind (sort { $a <=> $b } keys %where) {
	if (@target_kinds) {
	    my @found = grep { m{^${kind}$} } @target_kinds;
	    delete $where{$kind}, next unless (@found);
	}
	my ($wherecond,$perlcond) = split(/\;/,$where{$kind});
	push(@whereconds,$wherecond);
    }
    @wherekinds = ();
    for my $kind (sort { $a <=> $b } keys %where) {
	$hits{$kind} = 0;
	push(@wherekinds,$kind);
    }
    my $genfilter = sprintf("(%s)",join(")OR(",@whereconds)); # generated part of the ODC row filter
    $odc_row_filter = sprintf("(%s)AND(%s)",$odc_row_filter,$genfilter) if (defined($odc_row_filter));
    $odc_row_filter = $genfilter unless (defined($odc_row_filter));
}
printf($ERR "odc_row_filter [length=%d] => %s\n",length($odc_row_filter),$odc_row_filter) if (defined($odc_row_filter) && ($debug || $verbose || $progress));

