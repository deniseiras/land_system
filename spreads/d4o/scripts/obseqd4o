sub OEVcache {
    my $ncache = keys %oev_cache;
    my $errcode = 0;
    unless ($ncache > 0) {
	%oev_cache = ();
	if (defined($oevdb)) {
	    my ($sth, $qres) = (undef, undef);
	    my ($dbh1) = &OpenDB($oevdb,"readonly");
	    if (defined($dbh1)) {
		# Read standard levels
		my ($dbh2) = &OpenDB($stdlevdb,"readonly");
		if (defined($dbh2)) {
		    $sth = &PrepareQueryDB($dbh2,
					   "SELECT id,plevel,log_plevel FROM std_plevels");
		    &ExecuteQueryDB($sth,"ReadOEV(std_plevels): SELECT id,plevel,log_plevel FROM std_plevels");
		    $qres = &FetchQueryDB($sth);
		    foreach my $row ( @$qres ) {
			my ($id,$plevel,$log_plevel) = @$row;
			$plevel{$id} = $plevel;
			$log_plevel{$id} = $log_plevel;
		    }
		    &FinishQueryDB($sth);
		    &CloseDB($dbh2,$stdlevdb);
		}
		else {
		    ++$errcode;
		}
		
		# Read varnos to adjust the %$varclass
		my ($dbh3) = &OpenDB($ecmwf_varno_descr,"readonly");
		if (defined($dbh3)) {
		    for (sort keys %$varclass) {
			my ($key,$value) = ($_,$varclass->{$_});
			my $sql = sprintf("SELECT GROUP_CONCAT(varno,'|') FROM ecmwf_varno_descr WHERE description REGEXP '^\\s*(%s)\\s*--\\s*'",$value);
			$sth = &PrepareQueryDB($dbh3,$sql);
			&ExecuteQueryDB($sth,"ReadOEV(ecmwf_varno_descr): $sql");
			$qres = &FetchQueryDB($sth);
			foreach my $row ( @$qres ) {
			    my ($varnos) = @$row;
			    $varclass->{$key} = $varnos;
			    last;
			}
			&FinishQueryDB($sth);
		    }
		    &CloseDB($dbh3,$ecmwf_varno_descr); # $ecmwf_varno_descr
		}
		else {
		    ++$errcode;
		}
		
		# Finally, fetch the oevars (obs error variances) with their lev(el)s
		for (sort keys %$varclass) {
		    my ($key,$value) = ($_,$varclass->{$_});
		    my $sql = sprintf("SELECT reportype,obstype,codetype,geoarea,varclass,levtype,levs,oevars FROM oev WHERE varclass = '%s'",$key);
		    $sth = &PrepareQueryDB($dbh1,$sql);
		    &ExecuteQueryDB($sth,"ReadOEV(oevdb): $sql");
		    $qres = &FetchQueryDB($sth);
		    foreach my $row ( @$qres ) {
			my ($reportype,$obstype,$codetype,$geoarea,$classkey,$levtype,$levs,$oevars) = @$row;
			my $oevkey = sprintf("%d,%d,%d,%d,%s",$reportype,$obstype,$codetype,$geoarea,$classkey);
			my $varnos = $varclass->{"$classkey"};
			$oev_cache{$oevkey} = sprintf("%s,%s,%s,%s",$varnos,$levtype,$levs,$oevars);
		    }
		    &FinishQueryDB($sth);
		}
	    
		&CloseDB($dbh1,$oevdb);
	    }
	}
	else {
	    $oevdb = undef;
	    ++$errcode;
	}
    }
    $ncache = ($errcode == 0) ? keys %oev_cache : -$errcode;
    return $ncache;
}

sub ICAO_ht2ps {
    # ICAO height (m) to pressure (Pascal) conversion
    my ($ht) = @_; # geopotential height in metres
    return undef unless (defined($ht));
    my $g = 9.80665; # WMO "g" (not used here)
    my $ZA = 5.252368255329;
    my $ZB = 44330.769230769;
    my $ZC = 0.000157583169442;
    my $ZP0 = 101325.00; # Pascals
    my $ZP11 = 22654.7172; # Pascals
    my $ZZ11 = 11000.0;
    my $p = undef;
    if ($ht <= $ZZ11) {
        $p = $ZP0 * (1.0-$ht/$ZB)**$ZA;
    }
    else {
        $p = $ZP11 * exp(-$ZC*($ht-$ZZ11));
    }
    return $p; # pressure in Pascals
}

sub DeriveOEV {
    my ($levelht,$channel,$vertco_type,$obsvalue,$levtype,$levs,$oevars) = @_;
    my $oev = undef;
    my @oev = split(/:/,$oevars);
    my $oevlen = @oev;
    #if ($levtype =~ m/^(ps|t2m|w10m)$/) {
    if ($levtype eq "raw") {
	# Super-trivial: Just one value for all
	$oev = $oev[0] if (@oev);
    }
    elsif ($levtype eq "prc") {
	# Super-trivial: Just certain percent of the [ABS] obsvalue (and power-of-2 since variance)
	if (@oev && defined($obsvalue)) {
	    $oev = abs($obsvalue) * (sqrt($oev[0])/100.0); # obs error e.g. $oev[0] = 100 => sqrt => 10% => 0.10
	    $oev = $oev * $oev; # obs error variance 
	}
    }
    elsif ($levtype eq "channel" && $vertco_type =~ m{^(3|4|7)$} && defined($channel)) {
	# Trivial
	$levs =~ s/:/|/g;
	if ($channel =~ m{^($levs)$}) {
	    my @chan = split(/\|/,$levs);
	    my $chanlen = @chan;
	    if ($chanlen == $oevlen) {
		my $idx = 0;
		for (@chan) {
		    $oev = $oev[$idx], last if ($channel == $_); # found
		    ++$idx;
		}
	    }
	}
    }
    elsif ($levtype eq "ht" && $vertco_type == 2 && defined($levelht)) {
	# Non-trivial : given N height (m) upper limits (thus $htupper below) from low to high => determine oev where "levelht" within adjacent levels
	my @levs = split(/:/,$levs); # levels from 1 to N -- NOT standard levels
	my $nlevs = @levs;
	my $idx = 0;
	for my $htupper (@levs) {
	    if ($levelht <= $htupper) {
		$oev = $oev[$idx];
		last; # found
	    }
	    ++$idx;
	}
	$oev = $oev[-1] unless (defined($oev)); # take oev from the the highest level
    }
    elsif ($levtype eq "stdlevs" && $vertco_type == 1 && defined($levelht)) {
	# Complex
	my @levs = split(/:/,$levs); # levels from 1 to 15
	my $nlevs = @levs;
	if ($nlevs == 15 && $nlevs == $oevlen) {
	    my $idx = 0;
	    if ($levelht >= $plevel{1}) {
		$idx = 1;
	    }
	    elsif ($levelht <= $plevel{15}) {
		$idx = 15;
	    }
	    if ($idx != 0) {
		$oev = $oev[--$idx]; # Fixed value if below/above the std range
	    }
	    else {
		my $found = 0;
		for (@levs) {
		    my $stdp = $plevel{$_};
		    $found = $_, last if ($stdp <= $levelht);
		}
		if ($found > 1 && $found < $nlevs) {
		    my $log_levelht = log($levelht);
		    my $log_stdp = $log_plevel{$found};
		    my $eps = 1.0e-14;
		    $idx = $found - 1;
		    if (abs($log_levelht - $log_stdp) < $eps) {
			$oev = $oev[$idx];
		    }
		    else { # interpolate
			my $idxm1 = $idx - 1;
			$oev = $oev[$idxm1] +
			    (($oev[$idx] - $oev[$idxm1])/($log_plevel{$found} - $log_plevel{$found-1}))*($log_levelht - $log_plevel{$found-1});
		    }
		}
	    }
	}
    }
    return $oev;
}

sub AddTimeSlots {
    my ($db_handle,$db_name,$label,$file_id) = @_;
    printf(STDERR "AddTimeSlots(%s,file_id=%s): numtsl=%d\n",$db_name,$file_id,$numtsl) if ($debug || $verbose || $progress);
    if ($numtsl > 0 || $incsecs != 0) {
	# Update hdr.timeslot
	my $sth = &PrepareQueryDB($db_handle,"SELECT id,epoch FROM hdr WHERE file_id = $file_id");
	&ExecuteQueryDB($sth,"$label: SELECT id,epoch FROM hdr WHERE file_id = $file_id");
        my @id = ();
	my @epoch = ();
	my $qres = &FetchQueryDB($sth);
        foreach my $row ( @$qres ) {
	    my ($id,$epoch) = @$row;
	    push(@id,$id);
	    push(@epoch,$epoch);
	}
	&FinishQueryDB($sth);
	
	$sth = &PrepareQueryDB($db_handle,"UPDATE hdr SET timeslot = ?1, yyyymmdd = ?2, hhmmss = ?3 WHERE id = ?4");
	my $idx = 0;
	for my $epoch (@epoch) {
	    my $id = $id[$idx++];
	    my ($yyyymmddhhmmss,$newepoch) = &IncYYYYMMDDHHMMSS($epoch);
	    my $yyyymmdd = substr($yyyymmddhhmmss,0,8);
	    my $hhmmss = substr($yyyymmddhhmmss,8,6);
	    my $timeslot = &Timeslot($newepoch);
	    &ExecuteQueryDB($sth,"$label: UPDATE hdr SET timeslot = ...",[$timeslot,$yyyymmdd,$hhmmss,$id]); # if (defined($timeslot));
	}
	&FinishQueryDB($sth);
	
	&OutsideTimeWindow($db_handle,$db_name,$label) if ($numtsl > 0); # Cull those rows where [hdr.]timeslot IS NULL
    }
}

sub AdjustTimeStamps {
    my ($db_handle,$db_name,$label,$file_id) = @_;
    if (abs($diffepoch) > 0) {
	# Update hdr.yyyymmdd & hdr.hhmmss
	printf(STDERR "AdjustTimeStamps(%s,file_id=%s): diffepoch=%d\n",$db_name,$file_id,$diffepoch) if ($debug || $verbose || $progress);
	my $sth = &PrepareQueryDB($db_handle,"SELECT id,epoch FROM hdr WHERE file_id = $file_id");
        &ExecuteQueryDB($sth,"$label: SELECT id,epoch FROM hdr WHERE file_id = $file_id");
        my @id = ();
	my @epoch = ();
	my $qres = &FetchQueryDB($sth);
        foreach my $row ( @$qres ) {
	    my ($id,$epoch) = @$row;
	    push(@id,$id);
	    push(@epoch,$epoch);
	}
	&FinishQueryDB($sth);
	
	$sth = &PrepareQueryDB($db_handle,"UPDATE hdr SET yyyymmdd = ?1, hhmmss = ?2 WHERE id = ?3");
	my $idx = 0;
	for my $epoch (@epoch) {
	    my $id = $id[$idx++];
	    my ($yyyymmddhhmmss,$newepoch) = &IncYYYYMMDDHHMMSS($epoch,$diffepoch);
	    my $yyyymmdd = substr($yyyymmddhhmmss,0,8);
	    my $hhmmss = substr($yyyymmddhhmmss,8,6);
	    &ExecuteQueryDB($sth,"$label: UPDATE hdr SET yyyymmdd = ...",[$yyyymmdd,$hhmmss,$id]);
	}
	&FinishQueryDB($sth);
    }
}

sub AssignOEVs {
    my ($db_handle,$db_name,$label) = @_;
    unless (defined($obs_error_variance)) {
	# Assign body.obs_error_variance's
	my $ncache = &OEVcache();
	if ($ncache > 0) {
	    for (sort keys %oev_cache) {
		my ($key,$value) = ($_,$oev_cache{$_});
		my ($reportype,$obstype,$codetype,$geoarea,$classkey) = split(/,/,$key);
		my ($varnos,$levtype,$levs,$oevars) = split(/,/,$value);
		$varnos =~ s/\|/,/g;
		$geoarea = 1; # always for now
		my $sql = sprintf("SELECT hdr_id,entryno,varno,levelht,channel,ABS(vertco_type),obsvalue".
				  " FROM hdr JOIN body ON id = hdr_id".
				  " WHERE obs_error_variance IS NULL".
				  #" AND obsvalue IS NOT NULL". # allow (for now) NULL obsvalues
				  " AND varno IN (%s)".
				  " AND obstype = %d AND codetype = %d".
				  " AND (reportype = %d OR %d = -1)"
				  ,$varnos,$obstype,$codetype,$reportype,$reportype);
		my $sth = &PrepareQueryDB($db_handle,$sql);
		ExecuteQueryDB($sth,"ODC: $sql");
		my $qres = &FetchQueryDB($sth);
		my @id = ();
		my @entryno = ();
		my @varno = ();
		my @lev = ();
		my @cha = ();
		my @vt = ();
		my @obsv = ();
		foreach my $row ( @$qres ) {
		    my ($id,$entryno,$varno,$lev,$cha,$vt,$obsv) = @$row;
		    push(@id,$id);
		    push(@entryno,$entryno);
		    push(@varno,$varno);
		    push(@lev,$lev);
		    push(@cha,$cha);
		    push(@vt,$vt);
		    push(@obsv,$obsv);
		}
		&FinishQueryDB($sth);
		my $nrows = @id;
		if ($nrows > 0) {
		    printf($ERR "%s : nrows = %d\n",$sql,$nrows);
		    my $idx = 0;
		    $sql = "UPDATE body SET obs_error_variance = ?3 WHERE hdr_id = ?1 AND entryno = ?2";
		    $sth = &PrepareQueryDB($db_handle,$sql);
		    my $nupd = 0;
		    for my $id (@id) {
			my $cha = $cha[$idx];
			my $lev = $lev[$idx];
			my $vt = $vt[$idx];
			my $obsv = $obsv[$idx];
			my $oev = &DeriveOEV($lev,$cha,$vt,$obsv,$levtype,$levs,$oevars);
			if (defined($oev)) {
			    my $entryno = $entryno[$idx];
			    &ExecuteQueryDB($sth,"ODC: $sql",[$id,$entryno,$oev]);
			    ++$nupd;
			}
			++$idx;
		    }
		    &FinishQueryDB($sth);
		    my $prc = (100.0*$nupd)/$nrows;
		    printf($ERR "%s : %d rows attempted to update out of %d (%.2f%%)\n",$sql,$nupd,$nrows,$prc);
		}
	    }
	}
    }
}

sub StatusZero {
    my ($db_handle,$db_name,$label,$file_id) = @_;

    my $st;
    
    {
	# De-activate those body entries which have obsvalue or obs_error_variance or levelht NULL -- body.status updated selectively

	my $hdrcond = "hdr_id IN (SELECT id FROM hdr WHERE file_id = $file_id)";
	$st = &UpdateStatus(undef,"body.status:obsvalue IS NULL",
			    { active => 0, problematic => 1, "body.obsvalue" => 1 });
	&CallCLI($db_handle,$db_name,0,undef,0,"UPDATE body SET $st WHERE obsvalue IS NULL AND $hdrcond");
	
	$st = &UpdateStatus(undef,"body.status:levelht IS NULL",
			    { active => 0, problematic => 1, "body.levelht" => 1 });
	&CallCLI($db_handle,$db_name,0,undef,0,"UPDATE body SET $st WHERE levelht IS NULL AND which_vert <> -2 AND $hdrcond"); # Ignore when which_vert = -2 since "has no specific vertical location (undefined)"
	
	$st = &UpdateStatus(undef,"body.status:obs_error_variance IS NULL",
			    { active => 0, problematic => 1, "body.obs_error_variance" => 1, "body.obs_error" => "1" });
	&CallCLI($db_handle,$db_name,0,undef,0,"UPDATE body SET $st WHERE obs_error_variance IS NULL AND $hdrcond");
    }

    {
	# Set hdr.status = 0 if lat & lon in degrees not in desired range (often a conversion from radians to degrees -precision issue) -- hdr.status updated selectively
	
	$st = &UpdateStatus(undef,"hdr.status:deglat out of range",
			       { active => 0, problematic => 1, "hdr.deglat" => 1 }); 
	&CallCLI($db_handle,$db_name,0,undef,0,"UPDATE hdr SET $st WHERE file_id = $file_id AND (deglat NOT BETWEEN -90 AND 90)");
	
	$st = &UpdateStatus(undef,"hdr.status:deglon out of range",
			       { active => 0, problematic => 1, "hdr.deglon" => 1 }); 
	&CallCLI($db_handle,$db_name,0,undef,0,"UPDATE hdr SET $st WHERE file_id = $file_id AND (deglon NOT BETWEEN 0 AND 360)");
    }
    
    {
	# Set hdr.status = 0 if ALL of its body-entries are not active
	my $sth = &PrepareQueryDB($db_handle,"SELECT id,COUNT(*) AS cnt FROM hdr join body ON id=hdr_id WHERE file_id = $file_id AND body.status & 1 = 0 GROUP BY 1 HAVING cnt = nbody");
	&ExecuteQueryDB($sth,"$label: SELECT id,COUNT(*) AS cnt FROM hdr join body ON id=hdr_id WHERE ...");
        my @id = ();
	my @nbody = ();
	my $qres = &FetchQueryDB($sth);
        foreach my $row ( @$qres ) {
	    my ($id,$nbody) = @$row;
	    push(@id,$id);
	    push(@nbody,$nbody);
	}
	&FinishQueryDB($sth);
	if (@nbody) {
	    $st = &UpdateStatus(undef,"hdr.status:body-entries are not active",
				{ active => 0, problematic => 1, "hdr.nbody" => 1 }); 
	    $sth = &PrepareQueryDB($db_handle,"UPDATE hdr SET $st WHERE file_id = $file_id AND nbody = ?1 AND id = ?2");
	    my $idx = 0;
	    for my $nbody (@nbody) {
		my $id = $id[$idx++];
		&ExecuteQueryDB($sth,"$label: UPDATE hdr SET $st WHERE ...",[$nbody,$id]);
	    }
	    &FinishQueryDB($sth);
	}
    }
}
