our $erronce = 0;
sub ErrExit {
    printf($ERR "\n");
    printf($ERR "##### Aborting ...\n") unless ($erronce++);
    if (0) {
	my $n = @_;
	printf($ERR "n = %d\n",$n);
	for (@_) {
	    printf($ERR "length = %d : %s\n",length($_),$_);
	}
	exit 1;
    }
    &confess( @_ );
}

$SIG{ __DIE__  } = sub { &ErrExit(@_); };
