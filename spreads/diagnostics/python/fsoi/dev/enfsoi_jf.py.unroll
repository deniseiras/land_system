# Determine how many db are present in the analysis and verification dir.
# Analisys check --------------------------------------------------------
print('\n\n Analysis db check ...')
print(' -------------------------------------------------------')

listdb_an=[]
rescatalog=False
catalog_file=''
for file in os.listdir(path2an):
