                            elif o2p in ['SAT_U_WIND_COMPONENT', 'SAT_V_WIND_COMPONENT']:
                                #print('appending satw prior:', prior[iss,:])
                                scatt_anT_satw = np.append(scatt_anT_satw, Tan_ens)  
