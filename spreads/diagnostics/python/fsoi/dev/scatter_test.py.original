                            elif o2p in ['AIRCRAFT_U_WIND_COMPONENT','AIRCRAFT_V_WIND_COMPONENT','ACARS_U_WIND_COMPONENT','ACARS_V_WIND_COMPONENT']:
                                #print('appending arcw prior:', prior[iss,:])
