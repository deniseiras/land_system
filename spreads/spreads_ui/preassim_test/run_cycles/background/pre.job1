#         done
    
#     # grep "0" check_assi.flag
#     # statA=$?
#     # if [ $statA -eq 0 ];then
#     #     echo -e "\n No assimilation attempt worked!\n"
#     #     exit 130
#     # else
#     #     # Forecast phase
#     #     if [ $FORECAST == "TRUE" ];then
#     #         sh cases_forecast.sh ${case_name} 5 ${FENS}
