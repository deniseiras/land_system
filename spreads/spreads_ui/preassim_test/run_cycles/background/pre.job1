# fi

# Before the case.submit we could need to restore the restart files
#sh cases_restart_management.sh ${case_name} 5 "retrieve"

string_id=""
inst=1
while [ $inst -le 5 ];do
    inst_string=$(printf _%04d $inst)
    # Run the case
    cd $CLONESROOT/$case_name$inst_string
    echo " Enter in: `pwd`"

    # Clean
    rm -f cesm.std*
    rm -f ./logs/run_environment.txt.*
    rm -f ./timing/cesm_timing* 

    if [ $CONT_RUN == "FALSE" ];then
        ./xmlchange CONTINUE_RUN=FALSE 
    else
        ./xmlchange CONTINUE_RUN=TRUE  
    fi

    if [ $ACTIVATE_ASSI == "TRUE" ];then
        echo " Activate assimilation for member ${inst}"
        ./xmlchange DATA_ASSIMILATION_ATM=TRUE 
    else
        echo " Deactivate assimilation for member ${inst}" 
        ./xmlchange DATA_ASSIMILATION_ATM=FALSE
    fi

    datevar=$(grep ice_ic user_nl_cice  | awk '{print $3}')
    datevar=$(cut -d'.' -f4 <<<"$datevar")
    y=$(cut -d'-' -f1 <<<"$datevar")
    m=$(cut -d'-' -f2 <<<"$datevar")
    d=$(cut -d'-' -f3 <<<"$datevar")
    s=$(cut -d'-' -f4 <<<"$datevar")

    if [ $(grep "sec_init" user_nl_cice) != "" ];then
        sed -i -e "s/sec_init=.*/sec_init=$s/g" user_nl_cice
    else
        echo "sec_init=$s" >> user_nl_cice
    fi

    if [ $(grep "day_init" user_nl_cice) != "" ];then
        sed -i -e "s/day_init=.*/day_init=$d/g" user_nl_cice
    else
        echo "day_init=$d" >> user_nl_cice
    fi

    if [ $(grep "month_init" user_nl_cice) != "" ];then
        sed -i -e "s/month_init=.*/month_init=$m/g" user_nl_cice
    else
        echo "month_init=$m" >> user_nl_cice
    fi

    if [ $(grep "year_init" user_nl_cice) != "" ];then
        sed -i -e "s/year_init=.*/year_init=$y/g" user_nl_cice
    else
        echo "year_init=$y" >> user_nl_cice
    fi    

    inst=$(echo "${inst}+1" | bc -l)

done
   
#    ncyc=$(echo "${ncyc}+1" | bc -l)
# done
echo ""
echo "----- END TASK ---"
echo ""
ecflow_client --label=Info "OK... 20230908  16:22"
wait                      # wait for background process to stop
ecflow_client --complete  # Notify ecFlow of a normal end
trap 0                    # Remove all traps
exit 0  