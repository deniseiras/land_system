%include <includes/head.h>

its=$(echo %TASK% | sed 's/mem_//g')
its=$(printf "%%04d" ${its})
# @ nodes_per_instance = 8
# @ nodes_per_instance = 12

export CESMEXP='cesm-exp'
export CLONESROOT="/work/cmcc/${USER}/${CESMEXP}/%CASE_NAME%/%CASE_NAME%_${its}"
export CESMDATAROOT='/data/inputs/CESM'

export CESMDIR=%MODELDIR%
export case_name=%CASE_NAME%

# Number of clones
export nens=%NENS%

# DART directory
# export dartroot="/work/cmcc/${USER}/CMCC-DART-RSYNC/CMCC-DART/"
export dartroot=%ECF_HOME%/../
export CIME_MODEL='cesm'

export DIVISION=csp

export case_name=%CASE_NAME%

export NCYCLES=%NCYCLES%

# After the first cylce CONT_RUN must be TRUE. (Use FALSE only if it is the start.)
export CONT_RUN=%CONT_RUN%

# Max number of time you try to launch assimilation after failure
export MAXTRY=%MAXTRY%

# Number of forecast members
export FENS=%FENS%

# For CMCC-CESM
export CIME_MODEL='cesm'

# Activate assimilation or do just a forecast
ACTIVATE_ASSI=$(ecflow_client --query event /%CASE_NAME%/run_cycles:ACTIVATE_ASSI)
if [ $ACTIVATE_ASSI == 'set' ];then
    export ACTIVATE_ASSI='TRUE'
else
    export ACTIVATE_ASSI='FALSE'
fi

# DA working dir
tmpdir="/work/cmcc/${USER}/CMCC-CM/TMP"$(echo "${case_name}" | tr [:lower:] [:upper:])

# Archive (to remove previous files)
archdir="/work/cmcc/${USER}/CMCC-CM/archive"

# Set the obs dir
baseobsdir=%BASEOBSDIR%

# Time slots used for the FGAT implementation (note: for every time timeslot you need to have an output from the model!)
nts=%DEP%

# Choose your exp template
script_name_original=%CASE_TEMPLATE%

# Chose the input namelist for DART
dartnamelist=%DART_NML_TEMPLATE%

#source /etc/profile.d/modules.sh

if [ %ECF_HOSTNAME% == 'zeus' ];then
   # BASHRC
   export LANGUAGE=en_US.UTF-8
   export LC_ALL=en_US.UTF-8
   export LANG=en_US.UTF-8
   export LC_TYPE=en_US.UTF-8

   module load impi20.1/19.7.217 impi20.1/netcdf/C_4.7.4-F_4.5.3_CXX_4.3.1 impi20.1/hdf5/1.12.0 intel20.1/20.1.217 intel20.1/cdo/1.9.8 intel20.1/eccodes/2.17.0 intel20.1/h4cflib/1.3 intel20.1/hdf4/4.2.13 intel20.1/hdf5/1.12.0 intel20.1/magics/3.3.1 intel20.1/nco/4.9.3 intel20.1/ncview/2.1.8 intel20.1/netcdf/C_4.7.4-F_4.5.3_CXX_4.3.1
   module load ncl/6.6.2
   source /zeus/opt/anaconda/3.9/etc/profile.d/conda.sh
   module load anaconda/3.9
   # conda activate /work/cmcc/mg20022/.conda/envs/ecflow

elif [ %ECF_HOSTNAME% == 'juno' ]; then

   echo "d4o modules for juno"
#   source %ECF_CLONE%/../d4o/load-modules-d4o.juno
fi

cd ${CLONESROOT}

# two nodes 18, one node 6
#./xmlchange PIO_STRIDE=6
#./xmlchange PIO_NUMTASKS=-99

# sleep ${its}
date
./case.submit > ${CLONESROOT}/submit_message

jobid=$(cat ${CLONESROOT}/submit_message | grep 'Submitted job id is' | awk '{print $5}')
ecflow_client --alter=add variable JOB_ID "${jobid}" /${case_name}/run_cycles/background/run/mem_$(echo %TASK% | sed 's/mem_//g')
ecflow_client --label=info "Waiting..."

bwait -w "started(${jobid})"

start=$(date "+%%Y-%%m-%%d %%H:%%M")
ecflow_client --label=info "START: $start"

bwait -r 1 -w "ended(${jobid})"

end=$(date "+%%Y-%%m-%%d %%H:%%M")

sleep 30
echo " Enter in: `pwd`"

#grep "MODEL EXECUTION HAS FINISHED" cesm.stdout* 
#grep "resubmit_num 0" cesm.stderr* is valid also for cesm2_3 
grep "resubmit_num 0" cesm.stderr.${jobid} 

# store exit status of grep
# if found grep will return 0 exit stauts
# if not found, grep will return a nonzero exit stauts
status=$?
if [ $status -eq 0 ];
then
    echo " job finished! "
else
    echo " ERROR: -------> job unfinished"
    exit 1
fi 




if [ ${ACTIVATE_ASSI}  == "FALSE" ];then

   #  inst_string=`printf _%04d $inst`
    echo "Linking the new cam_initial_${its} for possible DA run."

    cd ${CLONESROOT}
    rdir=$(./xmlquery RUNDIR | awk '{print $NF}')
    cd ${rdir}
    rfile=$(head -n 1 rpointer.atm)
    rm -f cam_initial_${its}.nc
    ln -s  ${rfile} cam_initial_${its}.nc  
fi





ecflow_client --label=info "START: ${start} / FINISH: ${end}"


%include <includes/tail.h>
