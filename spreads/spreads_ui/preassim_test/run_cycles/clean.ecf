export SCRIPTDIR="%ECF_HOME%/source/%CASE_NAME%/main_scripts"

cd ${SCRIPTDIR}

export nens=%NENS%
donepath=$(echo %ECF_NAME% | sed 's/%TASK%//g')

# Number of forecast members
FENS=%FENS%

export CESMEXP='cesm-exp'
export case_name=%CASE_NAME%
export CLONESROOT="/work/cmcc/${USER}/${CESMEXP}/${case_name}"
export NTSLOTS=13
export CASEROOT0001="$CLONESROOT/${case_name}_0001"
export TMPROOT="/work/cmcc/${USER}/CMCC-CM/TMP"$(echo "${case_name}" | tr [:lower:] [:upper:])

FORECAST=$(ecflow_client --query event /%CASE_NAME%/run_cycles:FORECAST)
if [ $FORECAST == 'set' ];then
    export FORECAST='TRUE'
else
    export FORECAST='FALSE'
fi
# sed -i "s@CASESCONTAINERF=/work/cmcc@CASESCONTAINERF=/users_home/cmcc@g" cases_clean_archive.sh

# ./cases_forecast_clean.sh %CASE_NAME%
./cases_clean_archive.sh %CASE_NAME% %NENS% $FORECAST %FENS%

sleep 5

./cases_forecast_archive.sh %CASE_NAME%


