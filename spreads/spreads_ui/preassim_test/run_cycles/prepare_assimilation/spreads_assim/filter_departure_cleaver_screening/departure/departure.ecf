%include <includes/head.h>

ecflow_client --label=info "Starting... $(date)"

export SCRIPTDIR="%ECF_HOME%/source/%CASE_NAME%/main_scripts"

cd ${SCRIPTDIR}

export nens=%NENS%
donepath=$(echo %ECF_NAME% | sed 's/%TASK%//g')
its=$(echo %TASK% | sed 's/dep_//g')

sleep $its

#===================================================
# Take the id of the case.submit processes
take_id()
{

  output=$($*)
  echo $output | head -n1 | cut -d'<' -f2 | cut -d'>' -f1
}

export CESMEXP='cesm-exp'
export case_name=%CASE_NAME%
export CLONESROOT="/work/cmcc/${USER}/${CESMEXP}/${case_name}"
export CASEROOT0001="$CLONESROOT/${case_name}_0001"
export TMPROOT="/work/cmcc/${USER}/CMCC-CM/TMP"$(echo "${case_name}" | tr [:lower:] [:upper:])

source /etc/profile.d/modules.sh
source /data/cmcc/${USER}/d4o/install/INTEL/source.me

if [ %ECF_HOSTNAME% == 'zeus' ];then

   source /etc/profile.d/modules.sh

   module load impi20.1/19.7.217 impi20.1/netcdf/C_4.7.4-F_4.5.3_CXX_4.3.1 impi20.1/hdf5/1.12.0 intel20.1/20.1.217 intel20.1/cdo/1.9.8 intel20.1/eccodes/2.17.0 intel20.1/h4cflib/1.3 intel20.1/hdf4/4.2.13 intel20.1/hdf5/1.12.0 intel20.1/magics/3.3.1 intel20.1/nco/4.9.3 intel20.1/ncview/2.1.8 intel20.1/netcdf/C_4.7.4-F_4.5.3_CXX_4.3.1
   module load ncl/6.6.2
   source /zeus/opt/anaconda/3.9/etc/profile.d/conda.sh
   module load anaconda/3.9
   # conda activate /work/cmcc/mg20022/.conda/envs/ecflow
elif [ %ECF_HOSTNAME% == 'juno' ]; then

   echo "d4o modules for juno"
   source %ECF_CLONE%/../d4o/load-modules-d4o.juno
fi

date
echo "BEGIN FILTER PROCESSES "

export NTSLOTS=%DEP%

cd ${CASEROOT0001}
echo $SHELL
echo " xmlquery start"
export scomp=`./xmlquery COMP_ATM      --value`
export CASE=`./xmlquery CASE          --value`
export ensemble_size=`./xmlquery NINST_ATM     --value`
export CAM_DYCORE=`./xmlquery CAM_DYCORE    --value`
export EXEROOT=`./xmlquery EXEROOT       --value`
export RUNDIR=`./xmlquery RUNDIR        --value`
export archive=`./xmlquery DOUT_S_ROOT   --value`
# export TOTALPES=`./xmlquery TOTALPES      --value`

export CONT_RUN=`./xmlquery CONTINUE_RUN  --value`
# when you make a long forecast run without assimilation and then you want to assimilate obs but you do not have
# inflation files then  force one cycle CONT_RUN FALSE
#exportenv CONT_RUN                  FALSE

export CHECK_TIMING=`./xmlquery CHECK_TIMING  --value`
export DATA_ASSIMILATION_CYCLES=`./xmlquery DATA_ASSIMILATION_CYCLES --value`

export nens=%NENS%
echo " TMPROOT= $TMPROOT"

export CASESRUNROOT=`echo $RUNDIR | sed -e "s/\/${case_name}_0001\/run//g" `
export MP_DEBUG_NOTIMEOUT=yes
export NUMTASKS_PERNODE='36'

export save_stages_freq="RESTART_TIMES"
export BASEOBSDIR="/users_home/cmcc/sm09722/BUFR_D4O"
export DIVISION=csp

cd ${TMPROOT}
export line=$(grep input_state_file_list input.nml | sed -e "s#[=,'\.]# #g" | awk '{print $2}' )
export input_file_list_name=$line
# If the file names in $output_state_file_list = names in $input_state_file_list,
# then the restart file contents will be overwritten with the states updated by DART.
export line=$(grep output_state_file_list input.nml | sed -e "s#[=,'\.]# #g" | awk '{print $2}')
export output_file_list_name=$line


cd ${TMPROOT}/TS${its}
if [ ! -f run_filter.bash ]; then 
   cp ${TMPROOT}/run_filter.bash . 
fi
rm -f log.txt
chmod 755 run_filter.bash


echo  "FGAT ON, TWO STEP ASSIMILATION, d4o_departure=yes/no"

# PHASE 1 departures computation
#-----------------------------------------------------------------------
echo "ENTER PHASE 1, PRIOR DEPARTURES COMPUTATION"
export DARTROOT=%ECF_HOME%/..

cd ${TMPROOT}
rm -rf   ./TS${its}/$input_file_list_name
rm -rf  ./TS${its}/$output_file_list_name
rm -rf  ./TS${its}/*output*.nc


export inst=1
while [ $inst -le $nens ] ;do
   export inst_string=$(printf _%%04d $inst)
   export cits=$(echo "${NTSLOTS}+1-${its}" | bc)
   export datets=$(ls -l $CASESRUNROOT/${case_name}$inst_string/run/*cam.i* | tail -n ${cits} | head -n 1 | cut -d '.' -f4)
   export ftoass="$CASESRUNROOT/${case_name}$inst_string/run/${case_name}$inst_string.cam.i.${datets}.nc"
   echo "TS${its}: insert ${ftoass} in ${input_file_list_name}"
   echo "${ftoass}" >> ./TS${its}/${input_file_list_name}

   inst=$(echo "${inst}+1" | bc)
done

echo "change the stages to write (no forecast) in TS${its}"
sed -i "s@.*stages_to_write.*=.*@stages_to_write='output'@g" ./TS${its}/input.nml


cd ${TMPROOT}/TS${its}
cp ${TMPROOT}/run_filter_departures.bash . 

rm -f assimilate.err
rm -f assimilate.out
echo "" > dart_log.out

echo "TS$its: change the name of the process in order to better follow what is happening with bjobs"
sed -i "s@.*#BSUB -J.*@#BSUB -J %CASE_NAME%_dep_TS${its}@g" run_filter_departures.bash
# jobid=$(take_id bsub < run_filter_departures.bash) 
nos=$(echo "%NODES%*72" | bc)
sed -i "s@1080@${nos}@g" run_filter_departures.bash
sed -i "s@p_short@%queue%@g" run_filter_departures.bash
sed -i "s@2:00@%walltime%@g" run_filter_departures.bash
jobid=$(take_id bsub < run_filter_departures.bash)
ecflow_client --alter=add variable JOB_ID "${jobid}" %ECF_NAME%
sleep 5
bwait -w "started(${jobid})"

start=$(date "+%%Y-%%m-%%d %%H:%%M")
ecflow_client --label=info "START: $start"
sleep 5
bwait -w "ended(${jobid})"

end=$(date "+%%Y-%%m-%%d %%H:%%M")

if [ $(grep "2" ${TMPROOT}/TS${its}/filter.flag) ];then
   echo " phase 1 ended succesfully, in TS"$its

   ecflow_client --label=info "Phase 1 ended succesfully, in TS${its}: START ${start} / FINISH: ${end}"
else
   ecflow_client --label=info "Phase 1 ended NOT succesfully: START $start / FINISH: ${end}"
   # ecflow_client --suspend=/%CASE_NAME%/run_cycles/prepare_assimilation/spreads_assim/filter_assim

   exit 1
fi

%include <includes/tail.h>